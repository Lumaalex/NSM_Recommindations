<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<script>
(function(){try{var o=JSON.parse(localStorage.getItem("iv_constructor_ui")||"null");
if(o&&o.theme==="dark")document.documentElement.setAttribute("data-theme","dark");
if(o&&o.fs){var v=[0.85,1,1.15,1.3,1.5][o.fs];if(v)document.documentElement.style.setProperty("--fs",v);}
}catch(e){}})();
</script>
<title>Конструктор рекомендаций — Игровое взаимодействие</title>
<style>
/*__CSS__*/
/* ==================================================== СТИЛИ V1 (перенос из v2, запись 44)
   Шапка в два ряда: 1-й ряд — заголовок и кнопки, 2-й ряд — чипы «кто/какой период/кто заполнял»
   и индикатор автосохранения. Правила не переопределяют gap/padding header.top,
   чтобы мобильная адаптация из app/style.css продолжала работать. */
header.top{flex-direction:column;align-items:stretch}
.hdrrow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;width:100%}
.hdrchips{display:flex;gap:6px;align-items:center;min-width:0;flex-wrap:wrap;width:100%;
  padding-top:calc(5px * var(--fs));border-top:1px solid rgba(255,255,255,.16)}
.hdrchips .pill{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:46vw;
  background:var(--soft);border:1px solid var(--line);color:var(--ink);font-size:calc(12px * var(--fs))}
.hdrchips .savechip{margin-left:auto}
@media(max-width:760px){
  .hdrrow{gap:7px}
  .hdrchips{padding-top:5px}
  .hdrchips .pill{max-width:72vw}
}
</style>
</head>
<body>
<div id="nojs" class="nojs">
  <b>Страница открыта без выполнения JavaScript — конструктор не запустится.</b>
  <p>На iPhone и iPad предпросмотр файла из мессенджера или из приложения «Файлы» (Quick Look) показывает
  только текст и кнопки и <u>не выполняет скрипты</u>. Это ограничение iOS, сам файл исправен: на компьютере
  он работает двойным кликом, а на телефоне — через Safari по адресу локального сервера.</p>
  <p><b>Как открыть на телефоне (3 шага):</b><br>
  1. На компьютере, лежащем в той же Wi‑Fi сети, запустите: <span class="kbd">python tools/serve.py</span><br>
  2. На телефоне откройте в <b>Safari</b> напечатанный адрес вида
     <span class="kbd">http://192.168.0.10:8000/Конструктор_рекомендаций.html</span><br>
  3. В Safari: «Поделиться» → «На экран «Домой»» — конструктор откроется как приложение и запомнит черновики.</p>
  <p>Альтернатива без компьютера: загрузите файл на любой статический хостинг (Netlify Drop, GitHub Pages,
  ваш сайт) и откройте ссылку в Safari. Черновики и настройки хранятся внутри браузера, интернет не нужен.</p>
</div>
<header class="top">
  <div class="hdrrow">
  <div>
    <h1>Конструктор рекомендаций</h1>
    <div class="sub">направление «Игровое взаимодействие» · стандарт центра · версия <span id="ver"></span></div>
  </div>
  <div class="spacer"></div>
  <button class="b ghost small" id="btnSaveProject" title="Сохранить недописанный документ в файл проекта"><span class="short">Сохранить</span><span class="lbl">Сохранить проект</span></button>
  <button class="b ghost small" id="btnLoadProject" title="Загрузить недописанный документ из файла проекта"><span class="short">Загрузить</span><span class="lbl">Загрузить проект</span></button>
  <div class="uictl">
    <button class="b ghost small" id="btnTheme" title="Переключить тему" aria-label="Переключить тему">🌙 тёмная</button>
    <button class="b ghost small" id="btnFontMinus" title="Уменьшить шрифт" aria-label="Уменьшить шрифт">A−</button>
    <span id="fsLabel" title="Масштаб шрифта">100%</span>
    <button class="b ghost small" id="btnFontPlus" title="Увеличить шрифт" aria-label="Увеличить шрифт">A+</button>
    <button class="b ghost small" id="btnMode" title="Простой режим: только оценка, фразы и кнопки. Продвинутый: служебные ID, связи, полный опросник DIR, редактор банка">Простой режим</button>
  </div>
  <button class="b ghost small" id="btnReset" title="Очистить черновик и начать новый документ"><span class="short">Новый</span><span class="lbl">Новый документ</span></button>
  </div>
  <div class="hdrchips">
    <span class="pill" id="hdrFio" title="ФИО подопечного — используется в заголовке документа и в имени файла">ФИО не указано</span>
    <span class="pill" id="hdrPeriod" title="Период реабилитации из шапки документа">период не указан</span>
    <span class="pill" id="hdrSpec" title="Специалист и количество занятий">специалист не указан</span>
    <span class="sub savechip" id="saveinfo">—</span>
  </div>
</header>
<nav class="tabs" id="tabs"></nav>
<main id="main"></main>

<input type="file" id="fileProject" accept=".json" style="display:none">
<input type="file" id="fileBank" accept=".json,.csv" style="display:none">

<script id="bank-data" type="application/json">/*__DATA__*/</script>
<script>
"use strict";
/* ==========================================================================
   КОНСТРУКТОР РЕКОМЕНДАЦИЙ
   Логика: наблюдение -> статус способности (S3/S2/S1/S0/SN) -> цель -> приём -> рекомендация.
   Данные банка фраз встроены в тег <script id="bank-data"> и могут быть заменены
   импортом JSON/CSV (вкладка «Банк фраз»). Правки банка сохраняются в localStorage.
   ========================================================================== */
const V1VER = '1.2.0';   // версия приложения V1 (см. CHANGELOG.md, записи 9–13, 46); данные — BANK.meta.version
const BANK_DEFAULT = JSON.parse(document.getElementById('bank-data').textContent);
/* --- перенос старых кодов банка на семантические (данные 1.2.0: AS1→AS1sens, AS4→AS4ini, RC1→RC1home…).
   Карта приходит в данных (code_migration). Старые сохранённые проекты и правки банка
   в localStorage переводятся на новые коды автоматически, ничего не теряется. --- */
const CODE_MIG = (BANK_DEFAULT && BANK_DEFAULT.code_migration) || {};
const migCode = x => (x && CODE_MIG[x]) || x;
function migrateBankLegacy(b){
  const M = CODE_MIG; if(!b || !Object.keys(M).length) return b;
  (b.microblocks||[]).forEach(m=>{ if(M[m.id]) m.id=M[m.id]; });
  (b.phrases||[]).forEach(p=>{
    if(M[p.id]) p.id=M[p.id];
    if(p.micro && M[p.micro]) p.micro=M[p.micro];
    ['links_goal','links_meth','links_rec'].forEach(k=>{ if(Array.isArray(p[k])) p[k]=p[k].map(x=>M[x]||x); });
  });
  (b.service_phrases||[]).forEach(s=>{ if(s.microblock && M[s.microblock]) s.microblock=M[s.microblock]; });
  (b.abilities||[]).forEach(a=>{ if(a.micro && M[a.micro]) a.micro=M[a.micro]; });
  (b.questionnaire||[]).concat(b.survey_core||[]).forEach(q=>{
    if(q.micro && M[q.micro]) q.micro=M[q.micro];
    Object.keys(q.key||{}).forEach(a=>{ const k=q.key[a]||{};
      ['as','goal','meth','rec','res','nxt'].forEach(f=>{ if(Array.isArray(k[f])) k[f]=k[f].map(x=>M[x]||x); }); });
  });
  (b.spheres||[]).forEach(sp=>{
    if(sp.micro && M[sp.micro]) sp.micro=M[sp.micro];
    if(Array.isArray(sp.bank_as)) sp.bank_as=sp.bank_as.map(x=>M[x]||x);
  });
  Object.keys(b.sphere_keys||{}).forEach(sid=>Object.keys(b.sphere_keys[sid]||{}).forEach(ped=>{
    const k=b.sphere_keys[sid][ped]||{};
    ['as','goal','meth','rec','res','nxt'].forEach(f=>{ if(Array.isArray(k[f])) k[f]=k[f].map(x=>M[x]||x); });
  }));
  return b;
}
function migrateDoc(d){
  const M = CODE_MIG; if(!d || !Object.keys(M).length) return d;
  if(d.micro){ const nu={};
    Object.keys(d.micro).forEach(k=>{ const v=d.micro[k]||{};
      (v.items||[]).forEach(i=>{ if(i && i.src) i.src=M[i.src]||i.src; });
      const nk=M[k]||k; if(nu[nk]) nu[nk].items=(nu[nk].items||[]).concat(v.items||[]); else nu[nk]=v; });
    d.micro=nu; }
  if(d.recTopics){ const nu={};
    Object.keys(d.recTopics).forEach(k=>{ const arr=d.recTopics[k]||[];
      arr.forEach(i=>{ if(i && i.src) i.src=M[i.src]||i.src; });
      const nk=M[k]||k; nu[nk]=(nu[nk]||[]).concat(arr); });
    d.recTopics=nu; }
  Object.keys(d.blocks||{}).forEach(bk=>(d.blocks[bk]||[]).forEach(i=>{ if(i && i.src) i.src=M[i.src]||i.src; }));
  return d;
}
const LS_BANK = 'iv_constructor_bank_v1';
const LS_DOC  = 'iv_constructor_doc_v1';
/* Если браузер запретил локальное хранилище (например, при открытии файла с ограничениями),
   работаем в памяти и предупреждаем: черновик надо сохранять кнопкой «Сохранить проект». */
const LS = (()=>{
  try{ const t='__probe'+Date.now(); window.localStorage.setItem(t,'1'); window.localStorage.removeItem(t);
       return {ok:true, api:window.localStorage}; }
  catch(e){ const m={}; return {ok:false, api:{getItem:k=>(k in m?m[k]:null),
    setItem:(k,v)=>{m[k]=String(v);}, removeItem:k=>{delete m[k];}}}; }
})();

/* ------------------------------------------------------- ТЕМА И РАЗМЕР ШРИФТА */
const LS_UI = 'iv_constructor_ui';
const FS_STEPS = [0.85, 1, 1.15, 1.3, 1.5];
let UI = (function(){ try{ const o=JSON.parse(LS.api.getItem(LS_UI)||'null');
    if(o && typeof o==='object') return {theme:(o.theme==='dark'?'dark':'light'),
      fsIdx:Math.min(FS_STEPS.length-1, Math.max(0, o.fsIdx|0)),
      mode:(o.mode==='full'?'full':'simple')}; }catch(e){}
  return {theme:'light', fsIdx:1, mode:'simple'}; })();
const isSimple = () => UI.mode !== 'full';
function applyUI(){
  document.documentElement.setAttribute('data-theme', UI.theme);
  document.documentElement.style.setProperty('--fs', FS_STEPS[UI.fsIdx]);
  const t=$('#btnTheme'); if(t) t.textContent = UI.theme==='dark' ? 'Светлая тема' : 'Тёмная тема';
  const l=$('#fsLabel'); if(l) l.textContent = Math.round(FS_STEPS[UI.fsIdx]*100)+'%';
  const m=$('#btnFontMinus'), pl=$('#btnFontPlus');
  if(m) m.disabled = UI.fsIdx<=0;
  if(pl) pl.disabled = UI.fsIdx>=FS_STEPS.length-1;
  const md=$('#btnMode'); if(md) md.textContent = isSimple() ? 'Продвинутый режим' : 'Простой режим';
}
function saveUI(){ LS.api.setItem(LS_UI, JSON.stringify(UI)); }

let BANK = loadBank();
let S = loadDoc();           // состояние документа
let TAB = 'header';

/* ---------------------------------------------------------------- УТИЛИТЫ */
const $ = (s,r)=> (r||document).querySelector(s);
const esc = t => String(t==null?'':t).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const byId = id => BANK.phraseIndex[id];
const uid  = p => p + '-' + Math.random().toString(36).slice(2,8);

function loadBank(){
  try{
    const raw = LS.api.getItem(LS_BANK);
    if(raw){ const b = JSON.parse(raw); if(b && b.phrases && b.phrases.length) return indexBank(migrateBankLegacy(b)); }
  }catch(e){ console.warn('банк из localStorage не прочитан', e); }
  return indexBank(JSON.parse(JSON.stringify(BANK_DEFAULT)));
}
function indexBank(b){
  b.phraseIndex = {}; (b.phrases||[]).forEach(p=> b.phraseIndex[p.id]=p);
  b.svcIndex = {};    (b.service_phrases||[]).forEach(s=> b.svcIndex[s.id]=s);
  b.microIndex = {};  (b.microblocks||[]).forEach(m=> b.microIndex[m.id]=m);
  b.blockIndex = {};  (b.blocks||[]).forEach(x=> b.blockIndex[x.id]=x);
  b.statusIndex = {}; (b.statuses||[]).forEach(x=> b.statusIndex[x.code]=x);
  b.qIndex = {};      (b.questionnaire||[]).forEach(q=> b.qIndex[q.id]=q);
  return b;
}
/* Микротемы с флагом v2only (сферы 8–9 форка «от общего к частному») в классической версии
   не показываются и в документ не попадают — они принадлежат только Конструктору_ИВ_версия2.html. */
function microV2Only(mid){ const m=(BANK.microIndex||{})[mid]; return !!(m&&m.v2only); }
function microV1(m){ return !!m && m.block==='AS' && !m.v2only; }
function phraseV1(p){ return !!p && p.active!==false && !(p.block==='AS' && microV2Only(p.micro)); }
/* сколько формулировок доступно именно в V1 и какие микротемы принадлежат только версии 2 */
function v1PhraseCount(){ return (BANK.phrases||[]).filter(phraseV1).length; }
function v2OnlyMicroNames(){ return (BANK.microblocks||[]).filter(m=>m.v2only)
  .map(m=>m.name+' ('+m.id+')').join(', '); }
function persistBank(){ LS.api.setItem(LS_BANK, JSON.stringify(stripBank(BANK))); flash('Банк фраз сохранён в этом браузере'); }
function stripBank(b){ const c = JSON.parse(JSON.stringify(b));
  ['phraseIndex','svcIndex','microIndex','blockIndex','statusIndex','qIndex'].forEach(k=>delete c[k]); return c; }

/* ------------------------------------------------------- СОСТОЯНИЕ ДОКУМЕНТА */
function blankDoc(){
  return {
    v: 1,
    direction: 'IV',
    subject: 'ребёнок',
    gender: 'm',
    showSubheads: false,
    includeWorklog: false,
    header: {fio:'', birth:'', period_start:'', period_end:'', specialist:'', sessions:'', direction_name:'Игровое взаимодействие'},
    answers: {},        // qid -> {value, note}
    iv2: {},            // iv2 id -> текст наблюдения
    micro: {},          // AS1sens..AS6com -> {status, items:[{src,text,example,status}], service}
    asService: '',      // общая служебная отметка блока «Актуальное состояние»
    blocks: {GOAL:[], METH:[], RES:[], NEXT:[], REC:[]},   // [{src,text,example,meta}]
    recTopics: {},      // RC1home..RC6peers -> [{src,text}]
    lit: BANK_DEFAULT.literature.slice(),
    notes: {}
  };
}
function loadDoc(){ try{ const r=LS.api.getItem(LS_DOC); if(r){const d=JSON.parse(r); if(d&&d.header) return migrateDoc(d);} }catch(e){}
  return blankDoc(); }
function save(){ LS.api.setItem(LS_DOC, JSON.stringify(S));
  const t=new Date(); $('#saveinfo').textContent='черновик сохранён '+t.toLocaleTimeString('ru-RU'); }
function flash(msg){ const el=$('#saveinfo'); if(!el) return; const old=el.textContent; el.textContent=msg;
  setTimeout(()=>{el.textContent=old;},2600); }

/* инициализация микроблоков, если их ещё нет */
function ensureMicro(){
  (BANK.microblocks||[]).forEach(m=>{
    if(!microV1(m)) return;   // микротемы только для версии 2 (AS7prax, AS8vis) в V1 не создаём
    if(!S.micro[m.id]) S.micro[m.id]={status:'', items:[], service:''};
  });
  (BANK.microblocks||[]).forEach(m=>{
    if(m.block!=='REC') return;
    if(!S.recTopics[m.id]) S.recTopics[m.id]=[];
  });
}

/* ------------------------------------------------------------- ГЕНДЕР/ТЕРМИН */
/* Важно: в JavaScript \b работает только для ASCII, поэтому границы слова задаём явно. */
const CYR = 'А-Яа-яЁё';
function wordRe(word){ return new RegExp('(^|[^'+CYR+'])'+word+'([^'+CYR+']|$)','g'); }
function wordSub(t, from, to){
  let prev=null, guard=0;
  while(prev!==t && guard++<6){ prev=t; t=t.replace(wordRe(from),(m,a,b)=>a+to+b); }
  return t;
}
const FEM_RULES = [
  ['Склонен','Склонна'],['склонен','склонна'],
  ['Способен','Способна'],['способен','способна'],
  ['Насторожен','Насторожена'],['насторожен','насторожена'],
  ['Стал','Стала'],['стал','стала'],
  ['Начал','Начала'],['начал','начала'],
  ['Проявил','Проявила'],['проявил','проявила'],
  ['Показал','Показала'],['показал','показала'],
  ['Использовал','Использовала'],['использовал','использовала'],
  ['Уменьшился','Уменьшилась'],['уменьшился','уменьшилась'],
  ['его','её'],['Его','Её'],['он','она'],['Он','Она'],
  ['сам','сама'],['Сам','Сама'],
];
/* Падежные формы термина. Если термин задан вручную и его нет в списке —
   заменяется только именительный падеж, остальные окончания специалист правит сам. */
const SUBJECT_FORMS = {
  'подопечный': ['подопечный','подопечного','подопечному','подопечного','подопечным','подопечном'],
  'девочка':    ['девочка','девочки','девочке','девочку','девочкой','девочке'],
  'мальчик':    ['мальчик','мальчика','мальчику','мальчика','мальчиком','мальчике'],
  'ребёнок':    ['ребёнок','ребёнка','ребёнку','ребёнка','ребёнком','ребёнке'],
};
const CHILD_FORMS = [  // исходные формы в порядке убывания длины
  ['ребёнком','ребенком'],['ребёнке','ребенке'],['ребёнка','ребенка'],['ребёнку','ребенку'],
  ['ребёнок','ребенок'],
  ['Ребёнком','Ребенком'],['Ребёнке','Ребенке'],['Ребёнка','Ребенка'],
  ['Ребёнку','Ребенку'],['Ребёнок','Ребенок']
];
function caseOf(src){
  const base={ 'ребёнком':'instr','ребенком':'instr','ребёнке':'prep','ребенке':'prep',
    'ребёнка':'gen','ребенка':'gen','ребёнку':'dat','ребенку':'dat','ребёнок':'nom','ребенок':'nom',
    'Ребёнком':'INSTR','Ребенком':'INSTR','Ребёнке':'PREP','Ребенке':'PREP','Ребёнка':'GEN','Ребенка':'GEN',
    'Ребёнку':'DAT','Ребенку':'DAT','Ребёнок':'NOM','Ребенок':'NOM' };
  return base[src]||'nom';
}
function adapt(text){
  if(!text) return '';
  let t = String(text);
  const subj=(S.subject||'').trim();
  if(subj && !/^(ребёнок|ребенок)$/i.test(subj)){
    const forms = SUBJECT_FORMS[subj.toLowerCase()];
    if(forms){
      const map={nom:forms[0],gen:forms[1],dat:forms[2],acc:forms[3],instr:forms[4],prep:forms[5]};
      CHILD_FORMS.forEach(([src])=>{
        const c=caseOf(src).toLowerCase();
        let to=map[c]||forms[0];
        if(caseOf(src)===caseOf(src).toUpperCase()) to=cap(to);   // исходное слово с заглавной
        t=wordSub(t,src,to);
      });
    }else{
      // произвольный термин: заменяем только именительный падеж
      t=wordSub(t,'ребёнок',subj); t=wordSub(t,'ребенок',subj);
      t=wordSub(t,'Ребёнок',cap(subj)); t=wordSub(t,'Ребенок',cap(subj));
    }
  }
  if(S.gender==='f') FEM_RULES.forEach(([from,to])=>{ t=wordSub(t,from,to); });
  return t;
}
const cap = s => s ? s[0].toUpperCase()+s.slice(1) : s;
/* русские склонения: plural(3,['замечание','замечания','замечаний']) */
function plural(n, forms){
  n=Math.abs(n)%100; const n1=n%10;
  if(n>10&&n<20) return forms[2];
  if(n1>1&&n1<5) return forms[1];
  if(n1===1) return forms[0];
  return forms[2];
}

/* ------------------------------------------------------------- РАБОТА С БЛОКАМИ */
function phraseText(id){ const p=byId(id); return p? p.text : ''; }
function addItem(block, srcId, text, extra){
  const it = Object.assign({src:srcId||'', text:text||phraseText(srcId)||'', example:''}, extra||{});
  if(block==='AS_MICRO') return it;
  if(!S.blocks[block]) S.blocks[block]=[];
  S.blocks[block].push(it); save(); return it;
}
function addMicroItem(micro, srcId, text){
  ensureMicro();
  S.micro[micro].items.push({src:srcId||'', text:text||phraseText(srcId)||'', example:'', status:S.micro[micro].status||''});
  save();
}
function addRecItem(topic, srcId, text){
  ensureMicro();
  if(!S.recTopics[topic]) S.recTopics[topic]=[];
  S.recTopics[topic].push({src:srcId||'', text:text||phraseText(srcId)||''});
  save();
}
/* где сейчас находится фраза и как её убрать одним нажатием */
/* человекочитаемые названия блока и микроблока по коду (перенос из v2, запись 45) */
function blockName(id){ const b=(BANK.blockIndex||{})[id]; return (b&&b.name)||id||'—'; }
function microName(id){ const m=(BANK.microIndex||{})[id]; return (m&&m.name)||id||'—'; }
function targetName(to){
  if(to==='ASSVC') return 'служебная отметка блока «Актуальное состояние»';
  if(to.indexOf('MICRO:')===0){ const m=(BANK.microIndex[to.split(':')[1]]||{});
    return 'актуальное состояние, п. '+(m?m.order+' «'+m.name+'»':to.split(':')[1]); }
  if(to.indexOf('REC:')===0){ const m=(BANK.microIndex[to.split(':')[1]]||{});
    return 'рекомендации: '+(m?m.name:to.split(':')[1]); }
  return ({GOAL:'цели на период',METH:'приёмы работы',RES:'результаты',NEXT:'цели на следующий период'})[to]||to;
}
function isAdded(id, to){
  if(to==='ASSVC') return S.asService===id;
  if(to.indexOf('MICRO:')===0){ const m=to.split(':')[1];
    if(BANK.svcIndex[id]) return ((S.micro[m]||{}).service===id);
    return ((S.micro[m]||{}).items||[]).some(i=>i.src===id); }
  if(to.indexOf('REC:')===0){ const t=to.split(':')[1];
    return (S.recTopics[t]||[]).some(i=>i.src===id); }
  return (S.blocks[to]||[]).some(i=>i.src===id);
}
function removeFrom(id, to){
  if(to==='ASSVC'){ if(S.asService!==id) return false; S.asService=''; return true; }
  if(to.indexOf('MICRO:')===0){ const m=to.split(':')[1]; ensureMicro();
    if(BANK.svcIndex[id]){ if(S.micro[m].service!==id) return false; S.micro[m].service=''; return true; }
    const arr=S.micro[m].items||[]; const it=arr.find(i=>i.src===id); if(!it) return false;
    if((it.text||'')!==phraseText(id) &&
       !confirm('Фраза была изменена вручную. Всё равно убрать её из документа?')) return false;
    S.micro[m].items=arr.filter(i=>i!==it); return true; }
  if(to.indexOf('REC:')===0){ const t=to.split(':')[1]; const arr=S.recTopics[t]||[];
    const it=arr.find(i=>i.src===id); if(!it) return false;
    S.recTopics[t]=arr.filter(i=>i!==it); return true; }
  const arr=S.blocks[to]||[]; const it=arr.find(i=>i.src===id); if(!it) return false;
  S.blocks[to]=arr.filter(i=>i!==it); return true;
}
function addBtn(id, to, freeLabel, addedLabel){
  const added=isAdded(id,to);
  const nm=esc(targetName(to));
  return '<button class="b small '+(added?'gray':'ghost')+'" data-add="'+esc(id)+'" data-to="'+esc(to)+'" '+
    'title="'+(added?'Убрать из: '+nm:'Добавить в: '+nm)+'">'+
    (added?(addedLabel||'✓ убрать'):(freeLabel||'+ в документ'))+'</button>';
}
function hasPhrase(block, srcId){
  if(block.startsWith('AS')) return (Object.values(S.micro).some(m=>m.items.some(i=>i.src===srcId)));
  if(block==='REC') return Object.values(S.recTopics).some(a=>a.some(i=>i.src===srcId));
  return (S.blocks[block]||[]).some(i=>i.src===srcId);
}

/* ================================================================= ВКЛАДКИ */
const TABS = [
  {id:'header',  name:'1. Шапка'},
  {id:'survey',  name:'2. Опросник', badge:()=> isSimple()? countCore() : countAnswers()},
  {id:'as',      name:'3. Актуальное состояние', badge:()=>countAS()},
  {id:'goals',   name:'4. Цели и приёмы', badge:()=>(S.blocks.GOAL.length+S.blocks.METH.length)},
  {id:'results', name:'5. Результаты', badge:()=>(S.blocks.RES.length+S.blocks.NEXT.length)},
  {id:'recs',    name:'6. Рекомендации', badge:()=>countRecs()},
  {id:'doc',     name:'7. Документ'},
  {id:'bank',    name:'Банк фраз'},
  {id:'help',    name:'Инструкция'},
];
function countAnswers(){ return Object.values(S.answers||{}).filter(a=>a && a.value!==''&&a.value!=null).length; }
function countAS(){ return Object.values(S.micro||{}).reduce((n,m)=>n+(m.items?m.items.length:0),0); }
function countRecs(){ return Object.values(S.recTopics||{}).reduce((n,a)=>n+a.length,0); }

function renderTabs(){
  const nav=$('#tabs'); nav.innerHTML='';
  TABS.forEach(t=>{
    const b=document.createElement('button');
    b.className = (TAB===t.id?'on':'');
    const n = t.badge? t.badge() : 0;
    b.innerHTML = esc(t.name) + (n? '<span class="badge">'+n+'</span>':'');
    b.onclick=()=>{TAB=t.id; render(); window.scrollTo(0,0);};
    nav.appendChild(b);
  });
}
/* --- чипы шапки: ФИО, период, специалист и количество занятий (перенос из v2, запись 44).
   Обновляются при каждом рендере и на каждый ввод в полях вкладки «1. Шапка». --- */
function syncHdrChips(){
  const h=(S&&S.header)||{};
  const f=$('#hdrFio'); if(f) f.textContent=(h.fio||'').trim()||'ФИО не указано';
  const a=(h.period_start||'').trim(), b=(h.period_end||'').trim(), p=$('#hdrPeriod');
  if(p) p.textContent=(a||b)? 'период: '+(a||'…')+' — '+(b||'…') : 'период не указан';
  const sp=(h.specialist||'').trim(), se=(h.sessions||'').trim(), s=$('#hdrSpec'), parts=[];
  if(sp) parts.push('специалист: '+sp);
  if(se) parts.push('занятий: '+se);
  if(s) s.textContent=parts.length? parts.join(' · ') : 'специалист не указан';
}
function render(){ renderTabs(); const m=$('#main'); ensureMicro(); syncHdrChips();
  m.innerHTML = ({header:vHeader, survey:vSurvey, as:vAS, goals:vGoals, results:vResults,
                  recs:vRecs, doc:vDoc, bank:vBank, help:vHelp})[TAB]();
  bind(); }

/* ============================================================ ВКЛАДКА 1: ШАПКА */
function vHeader(){
  const h=S.header; const dirOpts=(BANK.directions||[]).map(d=>
    `<option value="${d.id}" ${d.id===S.direction?'selected':''}>${esc(d.name)}${d.active?'':' (заготовка)'}</option>`).join('');
  const subjOpts=['ребёнок','подопечный','девочка','мальчик'].map(s=>
    `<option ${s===S.subject?'selected':''}>${s}</option>`).join('');
  return `
  <div class="card">
    <h2>Идентификация документа</h2>
    <p class="hint">Все поля шапки обязательны. Данные попадают в начало документа и в имя файла.</p>
    <div class="row">
      <div><label class="f">ФИО</label><input type="text" data-h="fio" value="${esc(h.fio)}" placeholder="Иванов Иван Иванович"></div>
      <div><label class="f">Дата рождения</label><input type="text" data-h="birth" value="${esc(h.birth)}" placeholder="01.01.2018"></div>
    </div>
    <div class="row">
      <div><label class="f">Дата начала периода реабилитации</label><input type="text" data-h="period_start" value="${esc(h.period_start)}" placeholder="19.07.2026"></div>
      <div><label class="f">Дата окончания периода реабилитации</label><input type="text" data-h="period_end" value="${esc(h.period_end)}" placeholder="01.08.2026"></div>
    </div>
    <div class="row">
      <div><label class="f">Специалист</label><input type="text" data-h="specialist" value="${esc(h.specialist)}" placeholder="Фамилия И.О."></div>
      <div><label class="f">Количество занятий</label><input type="text" data-h="sessions" value="${esc(h.sessions)}" placeholder="10"></div>
    </div>
    <div class="row">
      <div><label class="f">Направление</label><select data-dir>${dirOpts}</select></div>
      <div><label class="f">Название направления в заголовке</label><input type="text" data-h="direction_name" value="${esc(h.direction_name)}"></div>
    </div>
  </div>
  <div class="card">
    <h2>Настройки текста</h2>
    <div class="row">
      <div><label class="f">Как называть подопечного в тексте</label>
        <input type="text" list="subjList" data-subject value="${esc(S.subject)}">
        <datalist id="subjList">${subjOpts}</datalist>
        <div class="small muted">«ребёнок» по умолчанию; для взрослых поставьте «подопечный».</div></div>
      <div><label class="f">Род (окончания и местоимения)</label>
        <select data-gender>
          <option value="m" ${S.gender==='m'?'selected':''}>мужской</option>
          <option value="f" ${S.gender==='f'?'selected':''}>женский</option>
        </select>
        <div class="small muted">Автозамена окончаний приблизительная — текст всегда можно поправить вручную.</div></div>
    </div>
    <div class="row">
      <div><label class="f"><input type="checkbox" data-showsub ${S.showSubheads?'checked':''}>
        Показывать подзаголовки микроблоков (1.1–1.6) в «Актуальном состоянии»</label>
        <div class="small muted">В реальных заключениях центра текст идёт сплошными абзацами — по умолчанию подзаголовки выключены.</div></div>
      <div><label class="f"><input type="checkbox" data-worklog ${S.includeWorklog?'checked':''}>
        Добавить приложение «Рабочие материалы» (статусы, примеры наблюдений, ответы опросника)</label>
        <div class="small muted">Приложение хранит исходные наблюдения — откуда взят каждый вывод. Родителям не выдаётся.</div></div>
    </div>
  </div>
  </div>
  <div class="card">
    <h2>Стандарт документа</h2>
    <div class="notice info">${esc(BANK.meta.standard)}</div>
    <ol class="small">
      <li><b>7 смысловых блоков обязательны всегда</b>: Актуальное состояние · Цели на период · Приёмы работы ·
          Результаты · Цели на следующий период · Рекомендации · Рекомендуемая литература.</li>
      <li>Пропускать можно только отдельные формулировки внутри блока — вместо них ставится служебная отметка
          («не наблюдалось», «не проверялось», «не релевантно», «значимых изменений не зафиксировано»).</li>
      <li>В «Актуальном состоянии» обязательны 6 микротем: интерес · эмоции/саморегуляция · сенсорика ·
          контакт · игра · коммуникация.</li>
      <li>Ни одна оценка способности не вносится в документ без примера с занятия.</li>
      <li>Стабильное (S3) → ресурс и результаты. Иногда (S2) и с поддержкой (S1) → цели. Нет базы (S0) → цель
          на более базовой стадии. Стресс (SN) → сначала регуляция, стадия 1.</li>
    </ol>
  </div>`;
}

/* ============================================================ ВКЛАДКА 2: ОПРОСНИК */
function surveyGroups(){
  const g={};
  (BANK.questionnaire||[]).forEach(q=>{
    const key = q.source==='Сенсорика' ? 'Сенсорная переработка информации' : ('Стадия '+q.stage+': '+stageName(q.stage));
    (g[key]=g[key]||[]).push(q);
  });
  return g;
}
function stageName(n){
  return ({0:'индивидуальные особенности',1:'Совместное внимание и саморегуляция',2:'Контакт и общение',
    3:'Преднамеренность и обоюдная коммуникация',4:'Решение социальных проблем, регуляция настроения и самосознание',
    5:'Формирование символов, использование слов и понятий. Эмоциональные идеи',
    6:'Логический, абстрактный и эмоциональный интеллект'})[n]||'';
}
function vSurvey(){
  if(isSimple()) return vSurveySimple();
  const groups=surveyGroups();
  let html = `<div class="card">
    <h2>Опросник с ключом</h2>
    <p class="hint">Отметьте, что ребёнок демонстрирует. Шкала:
      <span class="pill S3">3</span> стабильно (сам, без помощи взрослого) ·
      <span class="pill S2">2</span> иногда (сам, но нестабильно) ·
      <span class="pill S1">1</span> только с поддержкой (слово / действие / аффект / условие) ·
      <span class="pill S0">0</span> не проявляется ·
      <span class="pill SN">N</span> не проверялось (стресс, перегрузка, отказ).</p>
    <div class="notice warn"><b>Правило статуса.</b> Если ребёнок проявил способность только после того, как специалист
      сказал слово, показал действием, использовал аффект или создал условие (например, показал знакомую сюжетную
      игрушку) — это <b>1 «с поддержкой»</b>, а не «стабильно». Яркое самостоятельное проявление даже за одно
      наблюдение допустимо считать <b>3 «стабильно»</b>.</div>
    <p class="hint">После ответа конструктор предлагает готовые формулировки для блоков. Кнопка «+ в документ»
      добавляет фразу, повторное нажатие («✓ убрать») забирает её обратно — если передумали или нажали не то.
      Всё добавленное можно перефразировать прямо в блоках документа.</p>
    <div class="statusbar">
      <button class="b gray small" data-survey-clear>Сбросить ответы опросника</button>
      <span class="small muted">Отвечено: <b id="ansCount">${countAnswers()}</b> из ${(BANK.questionnaire||[]).length}</span>
    </div>
  </div>`;
  Object.keys(groups).forEach(gname=>{
    html += `<div class="card"><h3>${esc(gname)}</h3>`;
    groups[gname].forEach(q=>{ html += qItem(q); });
    html += `</div>`;
  });
  html += `<div class="card"><h2>Наблюдательные вопросы ИВ2 (свободный ответ)</h2>
    <p class="hint">Эти вопросы не имеют шкалы — они помогают собрать фактуру для примеров с занятий.
    Ответы попадают в приложение «Рабочие материалы».</p>`;
  const iv2g={};
  (BANK.iv2_questions||[]).forEach(q=>{ (iv2g[q.group]=iv2g[q.group]||[]).push(q); });
  Object.keys(iv2g).forEach(g=>{
    html += `<details class="help"><summary>${esc(g)} (${iv2g[g].length})</summary>`;
    iv2g[g].forEach(q=>{
      html += `<div style="margin:8px 0"><label class="f">${esc(q.text)}</label>
        <textarea data-iv2="${q.id}" rows="2">${esc(S.iv2[q.id]||'')}</textarea></div>`;
    });
    html += `</details>`;
  });
  html += `</div>`;
  return html;
}
function qItem(q){
  const a = S.answers[q.id]||{};
  const simple = isSimple();
  const opts=[[3,'3 · стабильно'],[2,'2 · иногда'],[1,'1 · с поддержкой'],[0,'0 · не проявляется'],['N','N · не проверялось']];
  const sc = opts.map(([v,l])=>`<label class="${String(a.value)===String(v)?'on':''}">
      <input type="radio" name="q_${q.id}" value="${v}" ${String(a.value)===String(v)?'checked':''}> ${esc(l)}</label>`).join('');
  const note = `<textarea data-note="${q.id}" rows="2" placeholder="На 3 занятии в ситуации свободной игры с песком ребёнок самостоятельно наполнил формочку, перевернул её и посмотрел на педагогу. Педагог не подсказывал.">${esc(a.note||'')}</textarea>`;
  return `<div class="qitem${simple?' compact':''}" data-q="${q.id}">
    <div class="qt">${esc(q.text)}</div>
    ${simple? '' : `<div class="qmeta">${esc(q.source)} · ${esc(q.domain)}${q.micro? ' · микроблок: '+esc((BANK.microIndex[q.micro]||{}).name||q.micro):''}</div>`}
    <div class="scale">${sc}</div>
    ${simple
      ? `<details ${a.note?'open':''}><summary class="small muted">пример с занятия${a.note? ' ✓':''}</summary>${note}</details>`
      : `<label class="f">Пример с занятия (факт: что сделал ребёнок, что делал специалист)</label>${note}`}
    ${a.value!==undefined && a.value!=='' && a.value!==null ? keySuggestions(q,a.value) : ''}
  </div>`;
}
function keySuggestions(q, ans){
  const key = (q.key||{})[ans] || (q.key||{})[String(ans)];
  if(!key) return '';
  const secs=[['as','Актуальное состояние'],['goal','Цель'],['meth','Приём'],['rec','Рекомендация'],
              ['res','Результат'],['nxt','Цель на следующий период'],['svc','Служебная отметка']];
  let out='';
  secs.forEach(([k,label])=>{
    const ids = key[k]||[];
    if(!ids.length) return;
    out += `<div class="sugg"><div class="st">${esc(label)}</div>`;
    ids.forEach(id=>{
      const p = byId(id) || BANK.svcIndex[id];
      if(!p) return;
      const st = p.status && p.status.length<=2 ? `<span class="pill ${esc(p.status)}">${esc(p.status)}</span> ` : '';
      const block = p.block || 'SVC';
      out += `<div class="ph">${st}${esc(p.text)} ${addBtn(id, targetFor(k,p))}</div>`;
    });
    out += `</div>`;
  });
  const stCode = BANK.status_by_answer[String(ans)];
  if(stCode) out = `<div class="small muted" style="margin-top:6px">Статус по ответу:
      <span class="pill ${stCode}">${stCode}</span> ${esc((BANK.statusIndex[stCode]||{}).name||'')}${isSimple()? '': ' — '+esc(((BANK.statusIndex[stCode]||{}).goes_to)||'')}</div>` + out;
  return out;
}
function targetFor(k, p){
  if(k==='as') return 'MICRO:'+(p.micro||'AS1sens');
  if(k==='svc') return p.microblock ? 'MICRO:'+p.microblock : 'ASSVC';
  if(k==='rec') return 'REC:'+(p.micro||'RC4play');
  return ({as:'MICRO:AS1sens',goal:'GOAL',meth:'METH',res:'RES',nxt:'NEXT',rec:'REC'})[k]||'GOAL';
}
</script>
<script>
/* ============================================================ ВКЛАДКА 3: АКТУАЛЬНОЕ СОСТОЯНИЕ */
function vAS(){
  if(isSimple()) return vASSimple();
  let html = `<div class="card"><h2>1. Актуальное состояние</h2>
    <p class="hint">Только наблюдаемые факты: что ребёнок реально демонстрирует сейчас. Без целей, без «необходимо»,
    без рекомендаций. Все 6 микротем обязательны — если данных нет, ставится служебная фраза, микротема не удаляется.</p>
    <div class="notice info"><b>Как работать:</b> выберите статус микротемы → возьмите подходящие формулировки из банка
    → перефразируйте под ребёнка → обязательно приложите пример с занятия.</div></div>`;
  (BANK.microblocks||[]).filter(microV1).forEach(m=>{ html += microCard(m); });
  const gen=(BANK.service_phrases||[]).filter(x=>!x.microblock);
  html += `<div class="card"><h3>Общая служебная отметка для блока (не относится к одной микротеме)</h3>
    <p class="hint">Ставится, когда часть способностей нельзя оценить корректно. Блок при этом не удаляется.</p>
    <div class="statusbar">${gen.map(s=>`<button class="b small ${S.asService===s.id?'gray':'ghost'}" data-assvc="${s.id}" ${S.asService===s.id?'disabled':''}>${esc(s.situation)}</button>`).join('')}
    ${S.asService? '<button class="b danger small" data-assvc="">убрать</button>':''}</div>
    ${S.asService&&BANK.svcIndex[S.asService]? '<div class="notice info">'+esc(BANK.svcIndex[S.asService].text)+'</div>':''}
  </div>`;
  return html;
}
function microCard(m){
  const d = S.micro[m.id] || {status:'',items:[],service:''};
  const st = BANK.statuses.map(s=>`<option value="${s.code}" ${d.status===s.code?'selected':''}>${s.code} — ${esc(s.name)}</option>`).join('');
  const svc = (BANK.service_phrases||[]).filter(x=>x.microblock===m.id);
  const filled = (d.items&&d.items.length)||d.service;
  let items='';
  d.items.forEach((it,i)=>{
    items += `<li data-item="${m.id}:${i}">
      <textarea data-itext="${m.id}:${i}" rows="3">${esc(it.text)}</textarea>
      <div class="meta">
        ${it.src? '<span class="muted">из банка: '+esc(it.src)+'</span>':''}
        <span class="muted">Статус:</span>
        <select data-istatus="${m.id}:${i}">${'<option value="">—</option>'+BANK.statuses.map(s=>`<option value="${s.code}" ${(it.status||d.status)===s.code?'selected':''}>${s.code}</option>`).join('')}</select>
        <button class="b gray small" data-iup="${m.id}:${i}">↑</button>
        <button class="b gray small" data-idown="${m.id}:${i}">↓</button>
        <button class="b danger small" data-idel="${m.id}:${i}">удалить</button>
      </div>
      <label class="f" style="margin-top:6px">Пример с занятия ${needExample(m.id,it)?'<b style="color:var(--bad)">*</b>':''}</label>
      <textarea data-iex="${m.id}:${i}" rows="2" placeholder="На занятии №__ в ситуации __ ребёнок __. Специалист __ (без вмешательства / сказал / показал / создал условие). Ребёнок __.">${esc(it.example||'')}</textarea>
    </li>`;
  });
  return `<div class="mb" data-micro="${m.id}">
    <div class="hd"><span class="t">${esc(m.order)}. ${esc(m.name)}</span>
      <span class="small muted">статус микротемы:</span>
      <select data-mstatus="${m.id}" style="width:auto"><option value="">— не выбран —</option>${st}</select>
      ${d.items.length? '<span class="pill '+(d.status||'SN')+'">'+d.items.length+' фр.</span>':''} ${filled}
      ${d.service? '<button class="b gray small" data-svcdel="'+m.id+'">служебная: '+esc((BANK.svcIndex[d.service]||{}).situation||d.service)+' ✕</button>':''}
    </div>
    <div class="bd">
      <div class="small muted" style="margin-bottom:8px">${esc(statusHint(d.status))}</div>
      <ul class="items">${items||'<li class="muted">Формулировок пока нет — возьмите из банка ниже или напишите сами.</li>'}</ul>
      <div class="row" style="margin-top:8px">
        <div><label class="f">Своя формулировка</label>
          <textarea data-newtext="${m.id}" rows="2" placeholder="Своя фраза (можно перефразировать любую из банка)"></textarea></div>
      </div>
      <div class="statusbar" style="margin-top:8px">
        <button class="b small" data-addown="${m.id}">+ добавить свою фразу</button>
        ${svc.map(s=>`<button class="b gray small" data-svc="${m.id}|${s.id}">служебная: ${esc(s.situation)}</button>`).join('')}
      </div>
      <details class="help" style="margin-top:8px"><summary>Банк формулировок для этой микротемы (${bankCount('AS',m.id)})</summary>
        ${bankPicker('AS', m.id)}
      </details>
    </div></div>`;
}
function statusHint(code){
  if(!code) return 'Статус не выбран. Выберите статус микротемы — конструктор подскажет, куда пойдут формулировки.';
  const s=BANK.statusIndex[code]; if(!s) return '';
  return code+' — '+s.name+'. '+s.definition+' Куда идёт: '+s.goes_to;
}
function needExample(micro, it){
  const src = it.src? byId(it.src):null;
  if(src) return !!src.needs_example;
  return true;
}
function bankCount(block, micro){ return (BANK.phrases||[]).filter(p=>p.block===block && (!micro||p.micro===micro) && phraseV1(p)).length; }
function bankPicker(block, micro){
  let list=(BANK.phrases||[]).filter(p=>p.block===block && (!micro||p.micro===micro) && phraseV1(p));
  if(!list.length) return '<div class="muted small">В банке пока нет формулировок для этого блока. Добавьте их на вкладке «Банк фраз».</div>';
  const byStatus={};
  list.forEach(p=>{ (byStatus[p.status||'—']=byStatus[p.status||'—']||[]).push(p); });
  let out='';
  Object.keys(byStatus).sort().forEach(k=>{
    out += `<div class="small muted" style="margin:8px 0 3px"><span class="pill ${esc(k)}">${esc(k)}</span> ${esc((BANK.statusIndex[k]||{}).name||'')}</div>`;
    byStatus[k].forEach(p=>{
      const to = block==='AS' ? 'MICRO:'+micro : (block==='REC' ? 'REC:'+(p.micro||'RC4play') : block);
      out += `<div class="sugg" style="margin:4px 0"><div class="ph">${esc(p.text)}
        ${addBtn(p.id, to, '+ добавить')}
        ${p.example_hint? '<div class="small muted" style="margin-top:3px">Пример: '+esc(p.example_hint)+'</div>':''}
        <div class="small muted">ID: ${esc(p.id)}${p.links_goal&&p.links_goal.length? ' · цели: '+p.links_goal.map(esc).join(', '):''}${p.links_meth&&p.links_meth.length? ' · приёмы: '+p.links_meth.map(esc).join(', '):''}</div>
        ${linksButtons(p)}
      </div></div>`;
    });
  });
  return out;
}
function linksButtons(p){
  let out='';
  const groups=[['links_goal','GOAL','+ цель'],['links_meth','METH','+ приём'],['links_rec','REC','+ рекомендацию']];
  groups.forEach(([k,to,label])=>{
    (p[k]||[]).forEach(id=>{
      const lp=byId(id); if(!lp) return;
      const dest = to==='REC' ? 'REC:'+(lp.micro||'RC4play') : to;
      out += addBtn(id, dest, label+': '+id, '✓ '+label.slice(2)+': убрать')+' ';
    });
  });
  return out? '<div style="margin-top:4px">'+out+'</div>':'';
}

/* ============================================================ ВКЛАДКА 4: ЦЕЛИ И ПРИЁМЫ */
function vGoals(){
  if(isSimple()) return vGoalsSimple();
  return blockCard('GOAL','2. Цели на период реабилитации',
      'Цели ставятся из статусов S2 / S1 / S0 / SN. Для S3 цель не «сформировать», а «расширить» или «перенести в новые ситуации». Нет цели без наблюдения в блоке 1.')
    + blockCard('METH','3. Приёмы работы',
      'Каждый приём соответствует цели и обязательно подкреплён примером с занятия. Общая фраза без примера не считается заполненным блоком.', true);
}
function blockCard(block, title, hint, needEx){
  const items=(S.blocks[block]||[]);
  let lis='';
  items.forEach((it,i)=>{
    lis += `<li>
      <textarea data-btext="${block}:${i}" rows="2">${esc(it.text)}</textarea>
      ${needEx? `<label class="f" style="margin-top:6px">Пример с занятия <b style="color:var(--bad)">*</b></label>
        <textarea data-bex="${block}:${i}" rows="2" placeholder="Педагог положил желаемую игрушку в прозрачную коробку...">${esc(it.example||'')}</textarea>`:''}
      <div class="meta">${it.src? '<span class="muted">из банка: '+esc(it.src)+'</span>':''}
        <button class="b gray small" data-bup="${block}:${i}">↑</button>
        <button class="b gray small" data-bdown="${block}:${i}">↓</button>
        <button class="b danger small" data-bdel="${block}:${i}">удалить</button></div>
    </li>`;
  });
  const groups = blockGroups(block);
  return `<div class="card"><h2>${esc(title)}</h2><p class="hint">${esc(hint)}</p>
    <ul class="items">${lis||'<li class="muted">Пока пусто.</li>'}</ul>
    <div class="row"><div><label class="f">Своя формулировка</label>
      <textarea data-newblock="${block}" rows="2"></textarea></div></div>
    <div class="statusbar" style="margin-top:8px">
      <button class="b small" data-addownblock="${block}">+ добавить свою</button>
      ${block==='GOAL'? '<button class="b gray small" data-svctext="GOAL|SV-NOGOAL">служебная: целей нет</button>':''}
    </div>
    <details class="help" style="margin-top:8px"><summary>Банк формулировок (${(BANK.phrases||[]).filter(p=>p.block===block&&phraseV1(p)).length})</summary>
      ${groupedPicker(block, groups)}
    </details>
    ${block==='GOAL'? autoGoalsCard():''}
  </div>`;
}
function blockGroups(block){
  const g={};
  (BANK.phrases||[]).filter(p=>p.block===block&&phraseV1(p)).forEach(p=>{ const k=p.tags||'Прочее'; (g[k]=g[k]||[]).push(p); });
  return g;
}
function groupedPicker(block, groups){
  let out='';
  Object.keys(groups).forEach(k=>{
    out += `<details class="help"><summary>${esc(k)} (${groups[k].length})</summary>`;
    groups[k].forEach(p=>{
      out += `<div class="sugg" style="margin:4px 0"><div class="ph">${esc(p.text)}
        ${addBtn(p.id, block, '+ добавить')}
        <div class="small muted">ID: ${esc(p.id)} · статус: ${esc(p.status||'—')}</div>${linksButtons(p)}</div></div>`;
    });
    out += `</details>`;
  });
  return out||'<div class="muted small">Пусто — добавьте формулировки на вкладке «Банк фраз».</div>';
}
/* авто-подсказка: какие цели вытекают из выбранных формулировок актуального состояния */
function autoGoalsCard(){
  const sugg={};
  Object.keys(S.micro).forEach(mid=>{
    (S.micro[mid].items||[]).forEach(it=>{
      if(!it.src) return; const p=byId(it.src); if(!p) return;
      const st = it.status||S.micro[mid].status;
      (p.links_goal||[]).forEach(gid=>{ const g=byId(gid); if(g) sugg[gid]={p:g, st:st||p.status, from:p.id}; });
    });
  });
  const keys=Object.keys(sugg);
  if(!keys.length) return '';
  let out=`<div class="card" style="background:#f7fbfe"><h3>Подсказка: цели, связанные с выбранными формулировками</h3>`;
  keys.forEach(k=>{ const s=sugg[k];
    out += `<div class="sugg"><div class="ph"><span class="pill ${esc(String(s.st).split(',')[0])}">${esc(String(s.st).split(',')[0])}</span>
      ${esc(s.p.text)} ${addBtn(k,'GOAL','+ цель')}
      <div class="small muted">основание: ${esc(s.from)} · приёмы: ${(s.p.links_meth||[]).map(x=>addBtn(x,'METH','+ '+x,'✓ убрать')).join(' ')}</div>
      </div></div>`; });
  return out+`</div>`;
}

/* ============================================================ ВКЛАДКА 5: РЕЗУЛЬТАТЫ */
function vResults(){
  if(isSimple()) return vResultsSimple();
  return blockCard('RES','4. Результаты',
      'Только то, что ребёнок показывает СТАБИЛЬНО (S3). Формат: было → стало → доказательство. «Иногда» и «с поддержкой» в результаты не переносятся.', true)
    + `<div class="card"><div class="statusbar">
        <button class="b gray small" data-svctext="RES|SV-NOREZ">служебная: значимых изменений не зафиксировано</button>
        <span class="small muted">Используется, когда устойчивой динамики нет.</span></div></div>`
    + blockCard('NEXT','5. Цели на следующий период',
      'Формируются из незакрытых целей и новых зон роста, появившихся после результатов.')
    + `<div class="card"><div class="statusbar">
        <button class="b gray small" data-svctext="NEXT|SV-NONEXT">служебная: цели предыдущего периода сохраняются</button></div></div>`;
}

/* ============================================================ ВКЛАДКА 6: РЕКОМЕНДАЦИИ */
function vRecs(){
  if(isSimple()) return vRecsSimple();
  let html = `<div class="card"><h2>6. Рекомендации</h2>
    <p class="hint">Домашний перенос приёмов работы. Язык понятен родителю без объяснений специалиста.
    Формат: <b>что делать — как делать — зачем</b>. Термины («со-регуляция», «коммуникативные циклы», «праксис»)
    переводятся на бытовой язык.</p>
    <div class="notice info">Темы 1–5 обязательны. Тема 6 (сверстники) — по релевантности: если взаимодействие не
    организовывалось, ставится служебная фраза.</div></div>`;
  (BANK.microblocks||[]).filter(m=>m.block==='REC').forEach(m=>{
    const arr=S.recTopics[m.id]||[];
    let lis='';
    arr.forEach((it,i)=>{
      lis += `<li><textarea data-rtext="${m.id}:${i}" rows="3">${esc(it.text)}</textarea>
        <div class="meta">${it.src?'<span class="muted">из банка: '+esc(it.src)+'</span>':''}
        <button class="b gray small" data-rup="${m.id}:${i}">↑</button>
        <button class="b danger small" data-rdel="${m.id}:${i}">удалить</button></div></li>`;
    });
    html += `<div class="mb"><div class="hd"><span class="t">${esc(m.name)} ${m.mandatory?'<b style="color:var(--bad)">*</b>':''}</span>
      ${arr.length?'<span class="pill S3">'+arr.length+'</span>':''}</div>
      <div class="bd">
        <ul class="items">${lis||'<li class="muted">Пусто.</li>'}</ul>
        <div class="row"><div><label class="f">Своя рекомендация</label><textarea data-newrec="${m.id}" rows="2"></textarea></div></div>
        <div class="statusbar" style="margin-top:8px">
          <button class="b small" data-addownrec="${m.id}">+ добавить свою</button>
          ${m.service? `<button class="b gray small" data-svcrec="${m.id}|${m.service}">служебная фраза</button>`:''}
        </div>
        <details class="help" style="margin-top:8px"><summary>Банк формулировок (${bankCount('REC',m.id)})</summary>${bankPicker('REC',m.id)}</details>
      </div></div>`;
  });
  html += `<div class="card"><h3>Проверка «нет рекомендации без домашнего переноса»</h3>
    <p class="hint small">Специалисту нельзя писать родителю «со-регуляция аффекта». Нужно: «Когда ребёнок расстроился,
    сначала не объясняйте и не требуйте. Сядьте рядом, говорите тихо, используйте знакомое движение или сенсорную игру.
    Когда напряжение ушло — мягко возвращайтесь к игре».</p></div>`;
  return html;
}
</script>
<script>
/* ============================================================ ВКЛАДКА 7: ДОКУМЕНТ */
function vDoc(){
  const d=buildDoc();
  const chk=runChecklist(d);
  return `<div class="toolbar noprint">
      <button class="b" id="btnDocx">Скачать .docx</button>
      <button class="b ghost" id="btnCopy">Копировать текст</button>
      <button class="b ghost" id="btnPrint">Печать / PDF</button>
      <button class="b gray" id="btnTxt">Скачать .txt</button>
      <span class="spacer" style="flex:1"></span>
      <span class="small muted">Файл: <b class="filename">${esc(fileName(d))}</b></span>
    </div>
    <div class="card noprint"><h2>Контрольный чек-лист перед выдачей</h2>${checklistHtml(chk)}</div>
    <div id="docwrap">${docHtml(d)}</div>`;
}
function fileName(d){
  const fio=(S.header.fio||'без_ФИО').trim().replace(/\s+/g,'_');
  return 'Заключение_ИВ_'+fio+'_'+(S.header.period_end||'').replace(/\./g,'-')+'.docx';
}
/* --- сборка содержимого документа --- */
function buildDoc(){
  const B=[];
  const push=(title,paras,opts)=>B.push(Object.assign({title,paras},opts||{}));
  const microBlocks=(BANK.microblocks||[]).filter(microV1).sort((a,b)=>a.order-b.order);
  // 1. Актуальное состояние
  let asParas=[];
  microBlocks.forEach(m=>{
    const d=S.micro[m.id]||{items:[],status:'',service:''};
    let txts=(d.items||[]).map(i=>adapt(i.text)).filter(t=>t&&t.trim());
    if(d.service && BANK.svcIndex[d.service]){
      const st=adapt(BANK.svcIndex[d.service].text);
      if(txts.indexOf(st)<0) txts.push(st);
    }
    if(!txts.length) txts=['[микротема не заполнена]'];
    if(S.showSubheads) asParas.push({text:m.order+'. '+m.name, bold:true, sub:true});
    txts.forEach(t=>asParas.push({text:t}));
  });
  if(S.asService && BANK.svcIndex[S.asService]) asParas.push({text:adapt(BANK.svcIndex[S.asService].text), italic:true});
  push('Актуальное состояние', asParas);
  // 2. Цели
  push('Цели на период реабилитации:', itemsParas(S.blocks.GOAL));
  // 3. Приёмы
  push('Приёмы работы:', itemsParas(S.blocks.METH, true));
  // 4. Результаты
  push('Результаты:', itemsParas(S.blocks.RES, true));
  // 5. Цели на следующий период
  push('Цели на следующий период:', itemsParas(S.blocks.NEXT));
  // 6. Рекомендации
  let recParas=[];
  (BANK.microblocks||[]).filter(m=>m.block==='REC').forEach(m=>{
    const arr=S.recTopics[m.id]||[];
    const txts=arr.map(i=>adapt(i.text)).filter(t=>t&&t.trim());
    if(!txts.length && m.service && BANK.svcIndex[m.service]) txts.push(adapt(BANK.svcIndex[m.service].text));
    txts.forEach(t=>recParas.push({text:t}));
  });
  if(!recParas.length) recParas=[{text:'[блок не заполнен]'}];
  push('Рекомендации:', recParas);
  // 7. Литература
  push('Рекомендуемая литература:', (S.lit&&S.lit.length? S.lit: BANK.literature).map(t=>({text:t,li:true})));
  // приложение
  if(S.includeWorklog) push('Приложение. Рабочие материалы (родителям не выдаётся)', worklogParas(), {small:true});
  return {title:'Индивидуальные рекомендации по направлению «'+(S.header.direction_name||'Игровое взаимодействие')+'»',
          header:S.header, blocks:B};
}
function itemsParas(arr, withExamples){
  const out=[];
  (arr||[]).forEach(it=>{
    const t=adapt(it.text); if(t&&t.trim()) out.push({text:t});
    if(withExamples && it.example && it.example.trim()) out.push({text:'Пример с занятия: '+it.example.trim(), italic:true});
  });
  if(!out.length) out.push({text:'[блок не заполнен]'});
  return out;
}
function worklogParas(){
  const out=[];
  out.push({text:'Статусы и примеры наблюдений по микротемам', bold:true});
  (BANK.microblocks||[]).filter(m=>m.block==='AS').forEach(m=>{
    const d=S.micro[m.id]||{};
    out.push({text:m.order+'. '+m.name+' — статус '+(d.status||'не задан'), bold:true});
    (d.items||[]).forEach(it=>{
      out.push({text:'• '+(it.status||d.status||'—')+' | '+(it.src||'своя')+' | '+it.text});
      if(it.example) out.push({text:'  Пример: '+it.example, italic:true});
    });
    if(d.service && BANK.svcIndex[d.service]) out.push({text:'• служебная отметка: '+BANK.svcIndex[d.service].text, italic:true});
  });
  const answered=(BANK.questionnaire||[]).filter(q=>S.answers[q.id] && S.answers[q.id].value!=='' && S.answers[q.id].value!=null);
  if(answered.length){
    out.push({text:'Ответы по опроснику (стадии DIR)', bold:true});
    answered.forEach(q=>{
      const a=S.answers[q.id];
      out.push({text:q.id+' ['+a.value+'] '+q.text + (a.note? ' — пример: '+a.note : '')});
    });
  }
  const iv2ans=Object.keys(S.iv2||{}).filter(k=>(S.iv2[k]||'').trim());
  if(iv2ans.length){
    out.push({text:'Наблюдения по вопросам ИВ2', bold:true});
    iv2ans.forEach(k=>{ const q=(BANK.iv2_questions||[]).find(x=>x.id===k);
      out.push({text:(q?q.text:k)+': '+S.iv2[k]}); });
  }
  return out;
}
/* --- HTML-представление --- */
function docHtml(d){
  let h=`<div class="doc" id="docprint"><h1>${esc(d.title)}</h1>`;
  const rows=[['ФИО:',d.header.fio],['Дата рождения:',d.header.birth],
    ['Дата начала периода реабилитации:',d.header.period_start],
    ['Дата окончания периода реабилитации:',d.header.period_end],
    ['Специалист:',d.header.specialist],['Количество занятий:',d.header.sessions]];
  h+=`<table class="hdr">${rows.map(r=>`<tr><td style="width:44%">${esc(r[0])}</td><td>${esc(r[1]||'')}</td></tr>`).join('')}</table>`;
  d.blocks.forEach(b=>{
    h+=`<h2>${esc(b.title)}</h2>`;
    const lis=b.paras.filter(p=>p.li);
    const others=b.paras.filter(p=>!p.li);
    others.forEach(p=>{ h+=`<p${p.italic?' style="font-style:italic"':''}${p.sub?' style="margin-top:8px"':''}>${p.bold?'<b>':''}${esc(p.text)}${p.bold?'</b>':''}</p>`; });
    if(lis.length) h+=`<ol class="lit">${lis.map(p=>`<li>${esc(p.text)}</li>`).join('')}</ol>`;
  });
  return h+'</div>';
}
/* --- чек-лист --- */
function runChecklist(d){
  const res=[];
  const microAS=(BANK.microblocks||[]).filter(m=>m.block==='AS');
  const filled=microAS.filter(m=>{const x=S.micro[m.id]||{};return (x.items||[]).length||x.service;});
  const withStatus=microAS.filter(m=>{const x=S.micro[m.id]||{};return x.status;});
  const asItems=microAS.reduce((a,m)=>a.concat((S.micro[m.id]||{}).items||[]),[]);
  const noExample=asItems.filter(i=>!(i.example||'').trim());
  const methNoEx=(S.blocks.METH||[]).filter(i=>!(i.example||'').trim());
  const resBad=(S.blocks.RES||[]).filter(i=>{const p=i.src?byId(i.src):null; return p && /иногда|с поддержкой|при поддержке/i.test(i.text);});
  const goalsNoMeth=(S.blocks.GOAL||[]).length && !(S.blocks.METH||[]).length;
  const recMicro=(BANK.microblocks||[]).filter(m=>m.block==='REC'&&m.mandatory);
  const recEmpty=recMicro.filter(m=>!(S.recTopics[m.id]||[]).length && !m.service);
  const hdrOk=['fio','birth','period_start','period_end','specialist','sessions'].every(k=>(S.header[k]||'').trim());
  const litOk=(S.lit&&S.lit.length>=5);
  const terms=(S.recTopics?Object.values(S.recTopics).flat():[]).filter(i=>/со-регуляция|коммуникативн|праксис|вестибулярн|проприоцеп/i.test(i.text));
  res.push({id:'C0', text:'Заполнена шапка документа (ФИО, дата рождения, период, специалист, количество занятий).', pass:hdrOk, sev:'block'});
  res.push({id:'C1', text:'Все 7 смысловых блоков присутствуют в документе.', pass:d.blocks.length>=7, sev:'block'});
  res.push({id:'C2', text:'Заполнены все 6 микротем «Актуального состояния» ('+filled.length+'/6).', pass:filled.length===6, sev:'block'});
  res.push({id:'C3', text:'У микротем выбран статус S3/S2/S1/S0/SN ('+withStatus.length+'/6).', pass:withStatus.length===6, sev:'warn'});
  res.push({id:'C5', text:'У каждой формулировки актуального состояния есть пример с занятия (без примера: '+noExample.length+').', pass:noExample.length===0, sev:'block'});
  res.push({id:'C6', text:'Есть хотя бы одна цель на период.', pass:(S.blocks.GOAL||[]).length>0, sev:'warn'});
  res.push({id:'C7', text:'На цели есть приёмы работы.', pass:!goalsNoMeth, sev:'block'});
  const methWithEx=(S.blocks.METH||[]).length-methNoEx.length;
  res.push({id:'C8', text:'В блоке «Приёмы работы» есть хотя бы один конкретный пример с занятия (есть: '+methWithEx+').', pass:methWithEx>0, sev:'block'});
  res.push({id:'C8b', text:'Желательно: пример к каждому приёму (сейчас без примера '+methNoEx.length+' из '+(S.blocks.METH||[]).length+').', pass:methNoEx.length===0, sev:'warn'});
  res.push({id:'C9', text:'В результатах нет формулировок «иногда» / «с поддержкой» (найдено: '+resBad.length+').', pass:resBad.length===0, sev:'block'});
  res.push({id:'C10', text:'В рекомендациях нет профессиональных терминов без пояснения (подозрительных: '+terms.length+').', pass:terms.length===0, sev:'warn'});
  res.push({id:'C11', text:'Обязательные темы рекомендаций заполнены (пустых: '+recEmpty.length+').', pass:recEmpty.length===0, sev:'warn'});
  res.push({id:'C12', text:'Литература вставлена полным утверждённым списком ('+(S.lit||[]).length+' поз.).', pass:litOk, sev:'warn'});
  res.push({id:'C4', text:'Проверьте вручную: нет ли слова «стабильно» там, где была подсказка, показ, аффект или созданное условие.', pass:null, sev:'manual'});
  res.push({id:'C13', text:'Проверьте вручную: нет ли противоречий между блоками.', pass:null, sev:'manual'});
  return res;
}
function checklistHtml(chk){
  const fails=chk.filter(c=>c.pass===false&&c.sev==='block').length;
  const warns=chk.filter(c=>c.pass===false&&c.sev==='warn').length;
  let head = fails? `<div class="notice err">Есть <b>${fails}</b> ${plural(fails,['обязательное замечание','обязательных замечания','обязательных замечаний'])} — документ выдавать рано.</div>`
    : (warns? `<div class="notice warn">Обязательные требования выполнены. ${plural(warns,['Предупреждение','Предупреждения','Предупреждений'])}: ${warns}.</div>`
            : `<div class="notice ok">Чек-лист пройден. Проверьте два ручных пункта и выдавайте документ.</div>`);
  return head + chk.map(c=>{
    const cls = c.pass===null? 'soft' : (c.pass? 'pass':'fail');
    const ic = c.pass===null? '!' : (c.pass? '✓':'✕');
    return `<div class="check ${cls}"><span class="ic">${ic}</span><span>${esc(c.text)}</span></div>`;
  }).join('');
}
function docPlainText(d){
  let t=d.title+'\n\n';
  t+='ФИО: '+(d.header.fio||'')+'\nДата рождения: '+(d.header.birth||'')+'\n';
  t+='Дата начала периода реабилитации: '+(d.header.period_start||'')+'\n';
  t+='Дата окончания периода реабилитации: '+(d.header.period_end||'')+'\n';
  t+='Специалист: '+(d.header.specialist||'')+'\nКоличество занятий: '+(d.header.sessions||'')+'\n\n';
  d.blocks.forEach(b=>{ t+=b.title+'\n';
    b.paras.forEach(p=>{ t+= (p.li? ' • ': '') + p.text+'\n'; }); t+='\n'; });
  return t;
}
</script>
<script>
/*__DOCX_LIB__*/
function exportDocx(){
  const d=buildDoc();
  const zip=zipStore([
    {name:'[Content_Types].xml',data:CT_XML},
    {name:'_rels/.rels',data:RELS_XML},
    {name:'word/document.xml',data:buildDocumentXml(d)},
    {name:'word/styles.xml',data:STYLES_XML},
    {name:'word/numbering.xml',data:NUM_XML},
    {name:'word/_rels/document.xml.rels',data:DOC_RELS_XML},
  ]);
  downloadBlob(new Blob([zip],{type:'application/vnd.openxmlformats-officedocument.wordprocessingml.document'}), fileName(d));
  flash('Файл .docx сохранён');
}

/* ============================================================ ВКЛАДКА: БАНК ФРАЗ */
function vBank(){
  if(isSimple()) return vBankSimple();
  /* названия блоков и микроблоков — вместе с кодом, чтобы код не приходилось угадывать (перенос из v2, запись 45) */
  const blocks=(BANK.blocks||[]).map(b=>`<option value="${b.id}">${esc(b.name)} · ${esc(b.id)}</option>`).join('');
  const micros=(BANK.microblocks||[]).filter(m=>!m.v2only)
    .map(m=>`<option value="${m.id}">${esc(m.name)} · ${esc(m.id)}</option>`).join('');
  const stats=(BANK.statuses||[]).map(s=>`<option value="${s.code}">${s.code} — ${esc(s.name)}</option>`).join('');
  return `
  <div class="card">
    <h2>Банк формулировок</h2>
    <p class="hint">Мастер-база — файл <span class="kbd">Банк_фраз.xlsx</span>. Здесь можно добавлять и править фразы
    прямо в браузере: изменения хранятся в этом браузере (localStorage) и выгружаются в JSON/CSV.
    Чтобы перенести правки на другой компьютер — выгрузите JSON и загрузите его там.</p>
    <div class="statusbar">
      <button class="b small" id="bankAdd">+ Новая фраза</button>
      <button class="b ghost small" id="bankExportJson">Экспорт JSON</button>
      <button class="b ghost small" id="bankExportCsv">Экспорт CSV (для Excel)</button>
      <button class="b ghost small" id="bankImport">Импорт JSON / CSV</button>
      <button class="b danger small" id="bankReset">Вернуть встроенный банк</button>
      <span class="small muted">Всего фраз: <b id="bankCount">${v1PhraseCount()}</b> ·
        показано: <b id="bankRows">${v1PhraseCount()}</b></span>
    </div>
    <div class="filters">
      <div><label class="f">Блок</label><select id="fBlock"><option value="">все</option>${blocks}</select></div>
      <div><label class="f">Микроблок</label><select id="fMicro"><option value="">все</option>${micros}</select></div>
      <div><label class="f">Статус</label><select id="fStatus"><option value="">все</option>${stats}</select></div>
      <div><label class="f">Поиск по тексту</label><input type="text" id="fText" placeholder="сюжет, сенсор, инициатив..."></div>
    </div>
    <div class="small muted" id="bankNote" style="margin:6px 0"></div>
    <div class="scroll"><table class="bank" id="bankTable"></table></div>
  </div>
  <div class="card">
    <h2>Справочники</h2>
    <div class="grid2">
      <div><h3>Статусы способности</h3><div class="scrollx"><table class="bank">
        <tr><th>Код</th><th>Название</th><th>Когда ставим</th><th>Куда попадает</th></tr>
        ${BANK.statuses.map(s=>`<tr><td><span class="pill ${esc(s.code)}">${esc(s.code)}</span></td><td><b>${esc(s.name)}</b></td><td>${esc(s.definition)}</td><td>${esc(s.goes_to)}</td></tr>`).join('')}
      </table></div></div>
      <div><h3>Что считается поддержкой взрослого</h3><div class="scrollx"><table class="bank">
        <tr><th>Тип</th><th>Примеры</th></tr>
        ${BANK.support_types.map(s=>`<tr><td><b>${esc(s.name)}</b></td><td>${esc(s.examples)}</td></tr>`).join('')}
      </table></div>
      <div class="notice warn" style="margin-top:8px">Если без одного из этих четырёх компонентов ребёнок способность
      не проявил — это <b>S1 «с поддержкой»</b>, а не S3.</div></div>
    </div>
    <h3>Служебные фразы (когда данных нет)</h3>
    <div class="scrollx"><table class="bank"><tr><th>ID</th><th>Ситуация</th><th>Формулировка</th></tr>
      ${BANK.service_phrases.map(s=>`<tr><td>${esc(s.id)}</td><td>${esc(s.situation)}</td><td>${esc(s.text)}</td></tr>`).join('')}
    </table></div>
    <h3>Карта соответствия: наблюдение → цель → приём → рекомендация</h3>
    <div class="scroll" style="max-height:340px"><table class="bank">
      <tr><th>Маркер</th><th>Если стабильно</th><th>Если иногда</th><th>Цель</th><th>Приём</th><th>Рекомендация</th></tr>
      ${BANK.link_map.map(r=>`<tr><td><b>${esc(r.marker)}</b></td><td>${esc(r.stable)}</td><td>${esc(r.sometimes)}</td><td>${esc(r.goal)}</td><td>${esc(r.method)}</td><td>${esc(r.rec)}</td></tr>`).join('')}
    </table></div>
  </div>`;
}
function vBankSimple(){
  const stats=(BANK.statuses||[]).map(s2=>`<option value="${s2.code}">${s2.code} — ${esc(s2.name)}</option>`).join('');
  return `<div class="card"><h2>Банк формулировок (просмотр)</h2>
    <p class="hint">Здесь можно найти и прочитать формулировки, которые использует конструктор.
    Правки банка — в продвинутом режиме (кнопка «Продвинутый режим» в шапке) или в Google Таблице.</p>
    <div class="filters">
      <div><label class="f">Поиск по тексту</label><input type="text" id="fText" placeholder="сюжет, сенсор, инициатива…"></div>
      <div><label class="f">Статус</label><select id="fStatus"><option value="">все</option>${stats}</select></div>
      <div><label class="f">Найдено</label><input type="text" id="bankCountSimple" readonly value=""></div>
    </div>
    <div class="small muted" id="bankNote" style="margin:6px 0"></div>
    <div class="scroll"><table class="bank" id="bankTable"></table></div>
    <div class="statusbar" style="margin-top:10px">
      <button class="b ghost small" id="btnModeHint">Открыть продвинутый режим для правки банка</button>
    </div></div>`;
}
function renderBankTable(){
  const t=$('#bankTable'); if(!t) return;
  const fb=($('#fBlock')||{}).value||'', fm=($('#fMicro')||{}).value||'',
        fs=($('#fStatus')||{}).value||'', ft=(($('#fText')||{}).value||'').toLowerCase().trim();
  /* V1 показывает только свои формулировки: микротемы AS7prax/AS8vis принадлежат версии 2 */
  const all=(BANK.phrases||[]).length, own=v1PhraseCount();
  const rows=(BANK.phrases||[]).filter(p=>phraseV1(p)
    &&(!fb||p.block===fb)&&(!fm||p.micro===fm)&&(!fs||(p.status||'').indexOf(fs)>=0)
    &&(!ft||(p.text+' '+p.id+' '+(p.tags||'')).toLowerCase().indexOf(ft)>=0));
  const note=$('#bankNote');
  if(note) note.textContent = all>own
    ? 'Показаны формулировки этой версии: '+own+' из '+all+'. Ещё '+(all-own)+
      ' — микротемы «'+v2OnlyMicroNames()+'», они относятся только к Конструктору_ИВ_версия2.html.'
    : '';
  if(isSimple()){
    t.innerHTML='<tr><th>Статус</th><th>Блок · микротема</th><th>Формулировка</th></tr>'
      + rows.map(p=>`<tr><td><span class="pill ${esc(String(p.status||'').split(',')[0])}">${esc(p.status||'—')}</span></td>
        <td class="small muted">${esc(blockName(p.block))}${p.micro? ' · '+esc(microName(p.micro)):''}</td><td>${esc(p.text)}</td></tr>`).join('');
    const cn=$('#bankCountSimple'); if(cn) cn.value=rows.length+' из '+v1PhraseCount();
    return;
  }
  t.innerHTML = `<tr><th>ID</th><th>Блок</th><th>Микроблок</th><th>Статус</th><th>Формулировка</th><th>Пример</th><th>Связи</th><th></th></tr>`
    + rows.map(p=>`<tr>
      <td><input type="text" data-bf="id" data-bid="${esc(p.id)}" value="${esc(p.id)}" style="width:110px"></td>
      <td title="${esc(blockName(p.block))}">${esc(p.block)}</td><td title="${esc(p.micro? microName(p.micro):'')}">${esc(p.micro||'—')}</td>
      <td><span class="pill ${esc(String(p.status||'').split(',')[0])}">${esc(p.status||'—')}</span></td>
      <td><textarea data-bf="text" data-bid="${esc(p.id)}" rows="2">${esc(p.text)}</textarea>
          <input type="text" data-bf="tags" data-bid="${esc(p.id)}" value="${esc(p.tags||'')}" placeholder="тема/домен" style="margin-top:4px"></td>
      <td><input type="checkbox" data-bf="needs_example" data-bid="${esc(p.id)}" ${p.needs_example?'checked':''}>
          <div class="small muted">${esc(p.example_hint||'')}</div></td>
      <td class="small muted">цели: ${esc((p.links_goal||[]).join(', '))}<br>приёмы: ${esc((p.links_meth||[]).join(', '))}<br>рек.: ${esc((p.links_rec||[]).join(', '))}</td>
      <td><button class="b danger small" data-bdel="${esc(p.id)}">удалить</button></td></tr>`).join('');
  const br=$('#bankRows'); if(br) br.textContent=rows.length;
}

/* ============================================================ ВКЛАДКА: ИНСТРУКЦИЯ */
function vHelp(){
  if(isSimple()) return vHelpSimple();
  return `
  <div class="card"><h2>Пайплайн работы</h2>
    <p><span class="stepnum">1</span><b>Наблюдение.</b> Фиксируйте факт, а не вывод.
      Плохо: «ребёнок не идёт на контакт». Хорошо: «на 2 занятии ребёнок 3 минуты играл с песком самостоятельно;
      когда педагог молча сел рядом, не отвернулся; когда педагог взял такую же лопатку — посмотрел на него и продолжил копать».</p>
    <p><span class="stepnum">2</span><b>Кодирование статуса.</b> Ответьте на вопросы: ребёнок сделал сам? взрослый подсказывал словом?
      показывал действием? использовал эмоцию, интонацию, паузу? создал условие (игрушка, среда, ритуал, снижение нагрузки)?
      наблюдение было невключённым? проявление однократное или повторяющееся? Затем поставьте код
      <span class="pill S3">S3</span> <span class="pill S2">S2</span> <span class="pill S1">S1</span> <span class="pill S0">S0</span> <span class="pill SN">SN</span>.</p>
    <p><span class="stepnum">3</span><b>Перенос в документ.</b> Стабильное → ресурс и результаты. Иногда → цель закрепить.
      С поддержкой → цель снять опору. Нет базы → цель на более базовой стадии. Стресс → служебная отметка и приоритет регуляции.</p>
    <p><span class="stepnum">4</span><b>Сборка и проверка.</b> Вкладка «Документ»: чек-лист, скачивание .docx.</p>
    <div class="scrollx"><table class="bank"><tr><th>Статус</th><th>Актуальное состояние</th><th>Цели</th><th>Приёмы</th><th>Результаты</th></tr>
      <tr><td><span class="pill S3">S3</span></td><td>пишем как ресурс</td><td>цель расширения</td><td>поддержание и усложнение</td><td>можно</td></tr>
      <tr><td><span class="pill S2">S2</span></td><td>с квалификатором «иногда, избирательно»</td><td>закрепить</td><td>увеличение частоты</td><td>нет, пока не станет S3</td></tr>
      <tr><td><span class="pill S1">S1</span></td><td>с указанием опоры</td><td>снять поддержку</td><td>постепенное удаление опоры</td><td>нет, пока не станет S2/S3</td></tr>
      <tr><td><span class="pill S0">S0</span></td><td>«не наблюдалось»</td><td>базовый уровень</td><td>формирование базы</td><td>нет</td></tr>
      <tr><td><span class="pill SN">SN</span></td><td>«не проверялось»</td><td>приоритет регуляции</td><td>стабилизация состояния</td><td>нет</td></tr>
    </table></div>
  </div>
  <div class="card"><h2>Три правила против копипаста</h2>
    <ol>
      <li><b>Нет цели без наблюдения.</b> Нельзя написать «развивать сюжетную игру», если в актуальном состоянии
        про сюжетную игру ничего нет.</li>
      <li><b>Нет приёма без цели.</b> Нельзя написать «использовать би-ба-бо», если это не связано с целью.</li>
      <li><b>Нет рекомендации без домашнего переноса.</b> Специалисту — «со-регуляция аффекта», родителю —
        «когда ребёнок расстроился, сначала не объясняйте и не требуйте; сядьте рядом, говорите тихо…».</li>
    </ol>
    <h3>Минимальный формат примера с занятия</h3>
    <div class="notice info">На занятии [номер/дата] в ситуации [условие] ребёнок [действие].
      Специалист [без вмешательства / сказал / показал / создал условие]. Ребёнок [последствие].</div>
  </div>
  <div class="card"><h2>Как дополнять банк фраз</h2>
    <p><b>Вариант А — в Excel (рекомендуется).</b> Откройте <span class="kbd">Банк_фраз.xlsx</span>, лист «Фразы»,
    допишите строку. ID должен быть уникальным и понятным: <span class="kbd">AS5play-S2-07</span>
    (блок AS, микроблок AS5play «Игра», статус S2, порядковый номер). Затем выполните
    <span class="kbd">python tools/build.py</span> — конструктор и JSON пересоберутся из Excel.</p>
    <p><b>Вариант Б — прямо в конструкторе.</b> Вкладка «Банк фраз» → «+ Новая фраза» → заполнить →
    изменения сразу доступны в подборе. Кнопка «Экспорт JSON» сохраняет обновлённый банк файлом;
    «Импорт» загружает его на другом компьютере.</p>
    <p><b>Что обязательно указать в новой фразе:</b> блок, микроблок, статус, текст, «требует примера»,
    связанные цели / приёмы / рекомендации (ID). Связи нужны, чтобы опросник с ключом подсказывал всю цепочку.</p>
    <p class="hint">Правила пополнения: одна фраза = одна мысль; формулировка наблюдаема (не «развивается»,
    а «поддерживает цепочки контакта в несколько шагов»); для родителей — без терминов.</p>
  </div>
  <div class="card"><h2>Если на телефоне видны только кнопки шапки</h2>
    <p>Это предпросмотр iOS (Quick Look): он показывает HTML как картинку и не выполняет JavaScript.
    Лечится открытием в Safari: запустите на компьютере <span class="kbd">python tools/serve.py</span>,
    откройте на телефоне напечатанный адрес <span class="kbd">http://…:8000/…</span> в Safari и добавьте
    ярлык на домашний экран («Поделиться» → «На экран «Домой»»). Подробно — в README, раздел
    «Как открыть на телефоне».</p>
  </div>
  <div class="card"><h2>Тема, размер шрифта, работа с телефона</h2>
    <p>Кнопки в правой части шапки: <b>«Тёмная тема» / «Светлая тема»</b> — переключение оформления, <b>A− / A+</b> — размер шрифта
    (85%…150%, влияет на интерфейс и на предпросмотр документа). Настройки запоминаются в браузере.
    При печати и в PDF документ всегда выходит чёрным по белому в исходном кегле.</p>
    <p>На телефоне вкладки листаются свайпом по горизонтали, таблицы (банк фраз, справочники) прокручиваются
    внутри своих рамок, кнопки и шкалы опросника увеличены под палец. Черновик автосохраняется;
    для переноса между устройствами используйте «Сохранить проект» / «Загрузить проект».</p>
  </div>
  <div class="card"><h2>Файлы комплекта</h2>
    <div class="scrollx"><table class="bank">
      <tr><th>Файл</th><th>Зачем</th></tr>
      <tr><td><span class="kbd">Конструктор_рекомендаций.html</span></td><td>рабочий инструмент специалиста (этот файл)</td></tr>
      <tr><td><span class="kbd">Банк_фраз.xlsx</span></td><td>мастер-база формулировок, опросник с ключом, справочники</td></tr>
      <tr><td><span class="kbd">Шаблон_заключения_ИВ.docx</span></td><td>чистая форма документа для работы без конструктора</td></tr>
      <tr><td><span class="kbd">Памятка_специалиста.docx</span></td><td>пайплайн, статусы, чек-лист — можно распечатать</td></tr>
      <tr><td><span class="kbd">data/phrases.json</span></td><td>данные конструктора ( source of truth для сборки )</td></tr>
      <tr><td><span class="kbd">tools/build.py</span></td><td>пересборка всего комплекта из данных</td></tr>
    </table></div>
  </div>`;
}

/* ============================================================ ПРОСТОЙ РЕЖИМ */
function countCore(){ return (BANK.survey_core||[]).filter(q=>{ const a=S.answers[q.id];
  return a && a.value!=='' && a.value!=null; }).length; }
function vSurveySimple(){
  const core=BANK.survey_core||[];
  let html=`<div class="card"><h2>Оценка: ${core.length} вопросов</h2>
    <p class="hint">Отметьте уровень по каждой области. Шкала:
      <span class="pill S3">3</span> стабильно · <span class="pill S2">2</span> иногда ·
      <span class="pill S1">1</span> с поддержкой · <span class="pill S0">0</span> не проявляется ·
      <span class="pill SN">N</span> не проверялось.</p>
    <details class="help"><summary>Как отличить «иногда» от «с поддержкой»</summary>
      <div class="small">Проявил сам, но не всегда — <b>2</b>. Проявил только после слова, показа, эмоции взрослого
      или созданного условия (например, показали знакомую игрушку) — <b>1</b>. Яркое самостоятельное проявление
      даже за одно занятие — <b>3</b>. Не было возможностей или был стресс — <b>N</b>.</div></details>
    <div class="statusbar">
      <button class="b gray small" data-survey-clear>Сбросить ответы</button>
      <span class="small muted">Отвечено: <b>${countCore()}</b> из ${core.length}</span>
    </div></div>
    <div class="card">`;
  core.forEach(q=>{ html+=qItem(q); });
  html+=`</div>
    <div class="card"><details class="help"><summary>Подробная диагностика: полный список DIR и сенсорика
      (${(BANK.questionnaire||[]).length} пункта)</summary>`;
  const groups=surveyGroups();
  Object.keys(groups).forEach(g=>{ html+=`<h3>${esc(g)}</h3>`; groups[g].forEach(q=>{ html+=qItem(q); }); });
  html+=`</details></div>`;
  return html;
}
function vASSimple(){
  let html=`<div class="card"><h2>Актуальное состояние</h2>
    <p class="hint">Шесть областей. Выберите оценку области цветными кнопками, добавьте формулировки
    («+ фраза») и приложите пример с занятия. Пустых областей быть не должно: если данных нет —
    кнопка «+ фраза» → служебная отметка внизу списка.</p></div>`;
  (BANK.microblocks||[]).filter(m=>m.block==='AS').forEach(m=>{ html+=microCardSimple(m); });
  return html;
}
function microCardSimple(m){
  const d=S.micro[m.id]||{status:'',items:[],service:''};
  const chips=BANK.statuses.map(st=>`<label class="${d.status===st.code?'on':''}" data-chip="${m.id}|${st.code}"
      title="${esc(st.definition)}"><span class="pill ${st.code}">${st.code}</span> ${esc(st.name.toLowerCase())}</label>`).join('');
  let rows='';
  (d.items||[]).forEach((it,i)=>{
    rows+=`<li><textarea data-itext="${m.id}:${i}" rows="2">${esc(it.text)}</textarea>
      <details><summary class="small muted ${it.example?'':'must'}">пример с занятия${it.example?' ✓':' — обязательно'}</summary>
        <textarea data-iex="${m.id}:${i}" rows="2" placeholder="На занятии №__ в ситуации __ ребёнок __. Специалист __ (без вмешательства / сказал / показал / создал условие).">${esc(it.example||'')}</textarea>
      </details>
      <div class="meta"><button class="b danger small" data-idel="${m.id}:${i}">убрать ✕</button></div></li>`;
  });
  const svcTxt = d.service && BANK.svcIndex[d.service] ? BANK.svcIndex[d.service].text : '';
  return `<div class="mb"><div class="hd"><span class="t">${m.order}. ${esc(m.name)}</span>
      ${(d.items.length||d.service)?'<span class="pill S3">✓</span>':'<span class="pill S0">не заполнено</span>'}</div>
    <div class="bd">
      <div class="scale">${chips}</div>
      ${d.status? `<div class="small muted">${esc((BANK.statusIndex[d.status]||{}).goes_to||'')}</div>`:''}
      <ul class="items">${rows}</ul>
      ${svcTxt? `<div class="notice info">${esc(svcTxt)}
        <button class="b gray small" data-svcdel="${m.id}">убрать отметку</button></div>`:''}
      <div class="statusbar">
        <button class="b small" data-pick="MICRO:${m.id}">+ фраза</button>
        <button class="b ghost small" data-own-toggle="${m.id}">своя фраза</button>
      </div>
      <div id="own_${m.id}" style="display:none"><textarea data-newtext="${m.id}" rows="2"
        placeholder="Своя формулировка наблюдаемого факта"></textarea>
        <button class="b small" data-addown="${m.id}" style="margin-top:6px">добавить</button></div>
    </div></div>`;
}
function blockCardSimple(block,title,hint,needEx){
  const items=S.blocks[block]||[];
  let lis='';
  items.forEach((it,i)=>{
    lis+=`<li><textarea data-btext="${block}:${i}" rows="2">${esc(it.text)}</textarea>
      ${needEx? `<details><summary class="small muted ${it.example?'':'must'}">пример с занятия${it.example?' ✓':' — обязательно'}</summary>
        <textarea data-bex="${block}:${i}" rows="2" placeholder="Педагог __. Ребёнок __.">${esc(it.example||'')}</textarea></details>`:''}
      <div class="meta"><button class="b danger small" data-bdel="${block}:${i}">убрать ✕</button></div></li>`;
  });
  return `<div class="card"><h2>${esc(title)}</h2><p class="hint">${esc(hint)}</p>
    <ul class="items">${lis||'<li class="muted">Пока пусто.</li>'}</ul>
    <div class="statusbar">
      <button class="b small" data-pick="${block}">+ фраза</button>
      <button class="b ghost small" data-ownblock-toggle="${block}">своя фраза</button>
    </div>
    <div id="ownb_${block}" style="display:none"><textarea data-newblock="${block}" rows="2"
      placeholder="Своя формулировка"></textarea>
      <button class="b small" data-addownblock="${block}" style="margin-top:6px">добавить</button></div></div>`;
}
function vGoalsSimple(){
  return blockCardSimple('GOAL','2. Цели на период реабилитации',
      'Цели выводятся из оценок 2, 1, 0 и N. Для оценки 3 — цель расширения, а не «сформировать».',false)
    + blockCardSimple('METH','3. Приёмы работы',
      'Каждый приём — под свою цель. Обязателен пример с занятия.',true);
}
function vResultsSimple(){
  return blockCardSimple('RES','4. Результаты',
      'Только то, что ребёнок показывает стабильно (3). Формат: было → стало → доказательство.',true)
    + blockCardSimple('NEXT','5. Цели на следующий период',
      'Незакрытые цели плюс новые зоны роста после результатов.',false);
}
function vRecsSimple(){
  let html=`<div class="card"><h2>6. Рекомендации</h2>
    <p class="hint">Домашние инструкции родителям: что делать — как делать — зачем. Простыми словами, без терминов.</p></div>`;
  (BANK.microblocks||[]).filter(m=>m.block==='REC').forEach(m=>{
    const arr=S.recTopics[m.id]||[];
    let lis='';
    arr.forEach((it,i)=>{ lis+=`<li><textarea data-rtext="${m.id}:${i}" rows="2">${esc(it.text)}</textarea>
      <div class="meta"><button class="b danger small" data-rdel="${m.id}:${i}">убрать ✕</button></div></li>`; });
    html+=`<div class="mb"><div class="hd"><span class="t">${esc(m.name)} ${m.mandatory?'<b style="color:var(--bad)">*</b>':''}</span>
      ${arr.length?'<span class="pill S3">✓</span>':''}</div><div class="bd">
      <ul class="items">${lis}</ul>
      <div class="statusbar">
        <button class="b small" data-pick="REC:${m.id}">+ рекомендация</button>
        <button class="b ghost small" data-ownrec-toggle="${m.id}">своя</button>
      </div>
      <div id="ownr_${m.id}" style="display:none"><textarea data-newrec="${m.id}" rows="2"
        placeholder="Своя рекомендация простыми словами"></textarea>
        <button class="b small" data-addownrec="${m.id}" style="margin-top:6px">добавить</button></div>
      </div></div>`;
  });
  return html;
}
function vHelpSimple(){
  return `<div class="card"><h2>Как пользоваться: 4 шага</h2>
    <p><span class="stepnum">1</span><b>Шапка</b> — кто, период реабилитации, специалист, число занятий.</p>
    <p><span class="stepnum">2</span><b>Оценка</b> — 8 вопросов, шкала 3 / 2 / 1 / 0 / N. После ответа
      конструктор предложит готовые формулировки, цели, приёмы и рекомендации.</p>
    <p><span class="stepnum">3</span><b>Блоки</b> — по каждой области добавьте формулировки кнопкой «+ фраза»
      и приложите пример с занятия; затем цели, приёмы, результаты, следующий период и рекомендации —
      теми же кнопками.</p>
    <p><span class="stepnum">4</span><b>Документ</b> — проверка по чек-листу, скачивание .docx или Google Doc.</p>
    <div class="notice warn">Три запрета: нет цели без наблюдения; нет приёма без цели; нет рекомендации
      без домашнего переноса простыми словами.</div>
    <p class="small muted">Служебная информация (ID фраз, связи, полный опросник DIR, редактор банка) —
      в продвинутом режиме: кнопка «Продвинутый режим» в шапке.</p>
    <p class="small muted">Тема и размер шрифта — там же, в шапке.</p></div>`;
}

/* ============================================================ СОБЫТИЯ */
function bind(){
  // шапка
  document.querySelectorAll('[data-h]').forEach(el=>el.oninput=()=>{S.header[el.dataset.h]=el.value; save(); syncHdrChips();});
  const dirSel=$('[data-dir]'); if(dirSel) dirSel.onchange=()=>{S.direction=dirSel.value;
    const d=(BANK.directions||[]).find(x=>x.id===S.direction); if(d) S.header.direction_name=d.name; save(); render();};
  const sub=$('[data-subject]'); if(sub) sub.oninput=()=>{S.subject=sub.value; save();};
  const gen=$('[data-gender]'); if(gen) gen.onchange=()=>{S.gender=gen.value; save();};
  const ss=$('[data-showsub]'); if(ss) ss.onchange=()=>{S.showSubheads=ss.checked; save();};
  const wl=$('[data-worklog]'); if(wl) wl.onchange=()=>{S.includeWorklog=wl.checked; save();};

  // опросник
  document.querySelectorAll('.qitem').forEach(box=>{
    const qid=box.dataset.q;
    box.querySelectorAll('input[type=radio]').forEach(r=>r.onchange=()=>{
      S.answers[qid]=S.answers[qid]||{}; S.answers[qid].value = r.value==='N'?'N':parseInt(r.value,10); save(); render();
    });
    const ta=box.querySelector('[data-note]'); if(ta) ta.oninput=()=>{ S.answers[qid]=S.answers[qid]||{};
      S.answers[qid].note=ta.value; save(); };
  });
  const clr=$('[data-survey-clear]'); if(clr) clr.onclick=()=>{ if(confirm('Сбросить все ответы опросника?')){S.answers={};save();render();} };
  document.querySelectorAll('[data-iv2]').forEach(el=>el.oninput=()=>{S.iv2[el.dataset.iv2]=el.value; save();});

  // добавление фраз из подсказок/банка
  document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{ toggleAdd(b.dataset.add, b.dataset.to); });
  document.querySelectorAll('[data-svc]').forEach(b=>b.onclick=()=>{ const [m,sid]=b.dataset.svc.split('|');
    ensureMicro(); S.micro[m].service=sid; S.micro[m].items=S.micro[m].items||[]; save(); render(); });
  document.querySelectorAll('[data-svcdel]').forEach(b=>b.onclick=()=>{ S.micro[b.dataset.svcdel].service=''; save(); render(); });
  document.querySelectorAll('[data-assvc]').forEach(b=>b.onclick=()=>{ S.asService=b.dataset.assvc||''; save(); render(); });
  document.querySelectorAll('[data-svcrec]').forEach(b=>b.onclick=()=>{ const [m,sid]=b.dataset.svcrec.split('|');
    const s=BANK.svcIndex[sid]; if(!s) return; addRecItem(m,'',s.text); save(); render(); });
  document.querySelectorAll('[data-svctext]').forEach(b=>b.onclick=()=>{ const [blk,sid]=b.dataset.svctext.split('|');
    const s=BANK.svcIndex[sid]; if(!s) return; addItem(blk,'',s.text); save(); render(); });
  document.querySelectorAll('[data-mstatus]').forEach(el=>el.onchange=()=>{ ensureMicro();
    S.micro[el.dataset.mstatus].status=el.value;
    S.micro[el.dataset.mstatus].items.forEach(i=>{ if(!i.status) i.status=el.value; }); save(); render(); });

  // элементы микроблоков
  document.querySelectorAll('[data-itext]').forEach(el=>el.oninput=()=>{ const [m,i]=el.dataset.itext.split(':');
    S.micro[m].items[+i].text=el.value; save(); });
  document.querySelectorAll('[data-iex]').forEach(el=>el.oninput=()=>{ const [m,i]=el.dataset.iex.split(':');
    S.micro[m].items[+i].example=el.value; save(); if(TAB==='doc') render(); });
  document.querySelectorAll('[data-istatus]').forEach(el=>el.onchange=()=>{ const [m,i]=el.dataset.istatus.split(':');
    S.micro[m].items[+i].status=el.value; save(); });
  document.querySelectorAll('[data-idel]').forEach(b=>b.onclick=()=>{ const [m,i]=b.dataset.idel.split(':');
    S.micro[m].items.splice(+i,1); save(); render(); });
  document.querySelectorAll('[data-iup]').forEach(b=>b.onclick=()=>{ const [m,i]=b.dataset.iup.split(':'); const a=S.micro[m].items;
    const n=+i; if(n>0){ [a[n-1],a[n]]=[a[n],a[n-1]]; save(); render(); } });
  document.querySelectorAll('[data-idown]').forEach(b=>b.onclick=()=>{ const [m,i]=b.dataset.idown.split(':'); const a=S.micro[m].items;
    const n=+i; if(n<a.length-1){ [a[n+1],a[n]]=[a[n],a[n+1]]; save(); render(); } });
  document.querySelectorAll('[data-addown]').forEach(b=>b.onclick=()=>{ const m=b.dataset.addown;
    const ta=document.querySelector('[data-newtext="'+m+'"]'); const v=(ta.value||'').trim(); if(!v) return;
    ensureMicro(); S.micro[m].items.push({src:'',text:v,example:'',status:S.micro[m].status||''}); ta.value=''; save(); render(); });

  // блоки 2-5
  document.querySelectorAll('[data-btext]').forEach(el=>el.oninput=()=>{ const [b,i]=el.dataset.btext.split(':');
    S.blocks[b][+i].text=el.value; save(); });
  document.querySelectorAll('[data-bex]').forEach(el=>el.oninput=()=>{ const [b,i]=el.dataset.bex.split(':');
    S.blocks[b][+i].example=el.value; save(); });
  document.querySelectorAll('[data-bdel]').forEach(x=>x.onclick=()=>{ const [b,i]=x.dataset.bdel.split(':');
    S.blocks[b].splice(+i,1); save(); render(); });
  document.querySelectorAll('[data-bup]').forEach(x=>x.onclick=()=>{ const [b,i]=x.dataset.bup.split(':'); const a=S.blocks[b]; const n=+i;
    if(n>0){[a[n-1],a[n]]=[a[n],a[n-1]];save();render();} });
  document.querySelectorAll('[data-bdown]').forEach(x=>x.onclick=()=>{ const [b,i]=x.dataset.bdown.split(':'); const a=S.blocks[b]; const n=+i;
    if(n<a.length-1){[a[n+1],a[n]]=[a[n],a[n+1]];save();render();} });
  document.querySelectorAll('[data-addownblock]').forEach(b=>b.onclick=()=>{ const blk=b.dataset.addownblock;
    const ta=document.querySelector('[data-newblock="'+blk+'"]'); const v=(ta.value||'').trim(); if(!v) return;
    addItem(blk,'',v); ta.value=''; render(); });

  // рекомендации
  document.querySelectorAll('[data-rtext]').forEach(el=>el.oninput=()=>{ const [m,i]=el.dataset.rtext.split(':');
    S.recTopics[m][+i].text=el.value; save(); });
  document.querySelectorAll('[data-rdel]').forEach(x=>x.onclick=()=>{ const [m,i]=x.dataset.rdel.split(':');
    S.recTopics[m].splice(+i,1); save(); render(); });
  document.querySelectorAll('[data-rup]').forEach(x=>x.onclick=()=>{ const [m,i]=x.dataset.rup.split(':'); const a=S.recTopics[m]; const n=+i;
    if(n>0){[a[n-1],a[n]]=[a[n],a[n-1]];save();render();} });
  document.querySelectorAll('[data-addownrec]').forEach(b=>b.onclick=()=>{ const m=b.dataset.addownrec;
    const ta=document.querySelector('[data-newrec="'+m+'"]'); const v=(ta.value||'').trim(); if(!v) return;
    addRecItem(m,'',v); ta.value=''; render(); });

  // простой режим: оценки-чипы, модалка подбора, свои фразы
  document.querySelectorAll('[data-chip]').forEach(l=>l.onclick=()=>{ const [m,code]=l.dataset.chip.split('|');
    ensureMicro(); S.micro[m].status = (S.micro[m].status===code? '' : code);
    S.micro[m].items.forEach(i=>{ if(!i.status) i.status=S.micro[m].status; }); save(); render(); });
  document.querySelectorAll('[data-pick]').forEach(b=>b.onclick=()=>openPicker(b.dataset.pick));
  ['own-toggle','ownblock-toggle','ownrec-toggle'].forEach(kind=>{
    document.querySelectorAll('[data-'+kind+']').forEach(b=>b.onclick=()=>{
      const id=b.dataset[kind.replace(/-([a-z])/g,(m,ch)=>ch.toUpperCase())];
      const box=document.getElementById(({ 'own-toggle':'own_','ownblock-toggle':'ownb_','ownrec-toggle':'ownr_' })[kind]+id);
      if(box) box.style.display = box.style.display==='none'? 'block':'none';
    });
  });

  // документ
  const bd=$('#btnDocx'); if(bd) bd.onclick=exportDocx;
  const bc=$('#btnCopy'); if(bc) bc.onclick=()=>{ const t=docPlainText(buildDoc());
    navigator.clipboard.writeText(t).then(()=>flash('Текст скопирован'),()=>{
      const ta=document.createElement('textarea'); ta.value=t; document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); ta.remove(); flash('Текст скопирован'); }); };
  const bp=$('#btnPrint'); if(bp) bp.onclick=()=>window.print();
  const bt=$('#btnTxt'); if(bt) bt.onclick=()=>downloadBlob(new Blob([docPlainText(buildDoc())],{type:'text/plain;charset=utf-8'}),
      fileName(buildDoc()).replace(/\.docx$/,'.txt'));

  // банк фраз
  const bmh=$('#btnModeHint'); if(bmh) bmh.onclick=()=>{ UI.mode='full'; saveUI(); applyUI(); render(); };
  const bAdd=$('#bankAdd'); if(bAdd) bAdd.onclick=()=>{
    const id=prompt('ID новой фразы (например AS5play-S2-07):'); if(!id) return;
    if(byId(id)){ alert('Такой ID уже есть'); return; }
    BANK.phrases.push({id:id,dir:S.direction,block:'AS',micro:'AS1sens',ability:'',status:'S2',text:'',
      source:'пользователь',needs_example:true,example_hint:'',links_goal:[],links_meth:[],links_rec:[],
      tags:'',active:true});
    BANK=indexBank(BANK); persistBank(); render(); };
  ['fBlock','fMicro','fStatus','fText'].forEach(id=>{ const el=$('#'+id); if(el){ el.oninput=renderBankTable; el.onchange=renderBankTable; } });
  renderBankTable();
  document.querySelectorAll('[data-bf]').forEach(el=>{
    const id=el.dataset.bid, f=el.dataset.bf; const p=byId(id); if(!p) return;
    const ev = (f==='needs_example')?'onchange':'oninput';
    el[ev]=()=>{ if(f==='id'){ const nv=el.value.trim(); if(!nv||nv===id) return;
        delete BANK.phraseIndex[id]; p.id=nv; BANK.phraseIndex[nv]=p; }
      else if(f==='needs_example') p.needs_example=el.checked;
      else p[f]=el.value;
      persistBank(); if(f==='id') renderBankTable(); };
  });
  document.querySelectorAll('[data-bdel]').forEach(b=>b.onclick=()=>{ const id=b.dataset.bdel;
    if(!confirm('Удалить фразу '+id+'?')) return;
    BANK.phrases=BANK.phrases.filter(p=>p.id!==id); BANK=indexBank(BANK); persistBank(); renderBankTable(); });
  const bej=$('#bankExportJson'); if(bej) bej.onclick=()=>downloadBlob(new Blob([JSON.stringify(stripBank(BANK),null,2)],
      {type:'application/json'}),'bank_phrases.json');
  const bec=$('#bankExportCsv'); if(bec) bec.onclick=()=>downloadBlob(new Blob(['\ufeff'+toCsv(BANK.phrases)],
      {type:'text/csv;charset=utf-8'}),'phrases.csv');
  const bi=$('#bankImport'); if(bi) bi.onclick=()=>$('#fileBank').click();
  const br=$('#bankReset'); if(br) br.onclick=()=>{ if(confirm('Вернуть встроенный банк? Все правки банка в этом браузере будут потеряны.')){
      LS.api.removeItem(LS_BANK); BANK=indexBank(JSON.parse(JSON.stringify(BANK_DEFAULT))); render(); } };
}

/* единая точка добавления/удаления фразы (кнопки в страницах и в модалке подбора) */
function toggleAdd(id, to){
  if(isAdded(id,to)){
    if(removeFrom(id,to)) flash('Убрано: '+targetName(to));
  } else {
    if(to==='ASSVC'){ S.asService=id; }
    else if(to.indexOf('MICRO:')===0){ const m=to.split(':')[1]; ensureMicro();
      if(BANK.svcIndex[id]){ S.micro[m].service=id; }
      else { addMicroItem(m,id);
        if(!S.micro[m].status){ const p=byId(id); if(p&&p.status&&p.status.length===2) S.micro[m].status=p.status; } } }
    else if(to.indexOf('REC:')===0){ addRecItem(to.split(':')[1], id); }
    else addItem(to, id);
    flash('Добавлено: '+targetName(to));
  }
  save(); render();
  if(document.getElementById('pickerBody')) renderPicker();
}

/* ============================================================ МОДАЛКА ПОДБОРА ФРАЗ */
let PICKER = null;   // {to, status, q}
function openPicker(to, status){
  PICKER = {to:to, status:status||'', q:''};
  const ov=document.createElement('div'); ov.id='pickerOv'; ov.className='pickov';
  ov.innerHTML='<div class="pick"><div class="pickhd"><b id="pickerTitle"></b>'+
    '<button class="b gray small" id="pickerClose">закрыть ✕</button></div>'+
    '<div class="pickfilters"><input type="text" id="pickerQ" placeholder="поиск по тексту фразы…">'+
    '<div id="pickerStatus" class="scale"></div></div>'+
    '<div id="pickerBody" class="pickbody"></div></div>';
  document.body.appendChild(ov);
  ov.onclick=e=>{ if(e.target===ov) closePicker(); };
  $('#pickerClose').onclick=closePicker;
  $('#pickerQ').oninput=e=>{ PICKER.q=e.target.value.toLowerCase().trim(); renderPicker(); };
  renderPicker();
  setTimeout(()=>{ const i=$('#pickerQ'); if(i) i.focus(); },50);
}
function closePicker(){ PICKER=null; const ov=$('#pickerOv'); if(ov) ov.remove(); }
document.addEventListener('keydown', e=>{ if(e.key==='Escape' && PICKER) closePicker(); });
function pickerCandidates(){
  const to=PICKER.to;
  let list=[];
  if(to.indexOf('MICRO:')===0){ const m=to.split(':')[1];
    list=(BANK.phrases||[]).filter(p=>p.block==='AS'&&p.micro===m&&phraseV1(p)); }
  else if(to.indexOf('REC:')===0){ const t=to.split(':')[1];
    list=(BANK.phrases||[]).filter(p=>p.block==='REC'&&p.micro===t&&p.active!==false); }
  else list=(BANK.phrases||[]).filter(p=>p.block===to&&p.active!==false);
  if(PICKER.q) list=list.filter(p=>(p.text+' '+(p.tags||'')).toLowerCase().indexOf(PICKER.q)>=0);
  if(PICKER.status) list=list.filter(p=>(p.status||'').split(',')[0]===PICKER.status);
  return list;
}
function renderPicker(){
  if(!PICKER) return;
  const to=PICKER.to;
  $('#pickerTitle').textContent='Подбор фраз: '+targetName(to);
  const statuses = (to.indexOf('MICRO:')===0||to==='GOAL'||to==='METH'||to==='RES'||to==='NEXT'||to.indexOf('REC:')===0)
    ? ['','S3','S2','S1','S0','SN'] : [''];
  $('#pickerStatus').innerHTML = statuses.map(st=>{
    const on = PICKER.status===st;
    return `<label class="${on?'on':''}" data-pst="${st}">${st? '<span class="pill '+st+'">'+st+'</span>':'все'}</label>`;
  }).join('');
  document.querySelectorAll('[data-pst]').forEach(l=>l.onclick=()=>{ PICKER.status=l.dataset.pst; renderPicker(); });
  const list=pickerCandidates();
  /* счётчик и легенда кодов — перенос из v2 (запись 45) */
  let html='<div class="small muted" style="margin-bottom:6px">Найдено: '+list.length+
    '. Кнопка «+ добавить» кладёт фразу в «'+esc(targetName(to))+'».<br>'+
    'Код фразы: блок · микротема · статус · номер — например <b>AS5play-S2-07</b> = «Актуальное состояние», '+
    'микротема «Игра» (AS5play), статус S2 (иногда), фраза 07.</div>';
  if(!list.length) html+='<div class="muted small" style="padding:10px">Ничего не найдено. Измените фильтр или добавьте свою фразу на странице блока.</div>';
  list.forEach(p=>{
    const meta = !isSimple()
      ? 'ID: '+esc(p.id)+(p.micro? ' · '+esc(microName(p.micro)):'')+(p.example_hint? ' · пример: '+esc(p.example_hint):'')
      : (p.micro? 'микротема: '+esc(microName(p.micro)) : '');
    html+=`<div class="prow"><div class="ptxt">${p.status&&p.status.length===2? '<span class="pill '+esc(p.status)+'">'+esc(p.status)+'</span> ':''}${esc(p.text)}
      ${meta? '<div class="small muted">'+meta+'</div>':''}</div>
      ${addBtn(p.id, to, '+ добавить')}</div>`;
  });
  if(to.indexOf('MICRO:')===0){
    const m=to.split(':')[1];
    const svc=(BANK.service_phrases||[]).filter(x=>x.microblock===m || !x.microblock);
    if(svc.length){
      html+='<div class="small muted" style="margin:10px 0 4px">Если данных нет — служебная отметка (блок не удаляется):</div>';
      svc.forEach(sv=>{
        const dest = sv.microblock? 'MICRO:'+sv.microblock : 'ASSVC';
        html+=`<div class="prow"><div class="ptxt">${esc(sv.text)}</div>${addBtn(sv.id, dest, '+ отметить')}</div>`;
      });
    }
  }
  $('#pickerBody').innerHTML=html;
  document.querySelectorAll('#pickerBody [data-add]').forEach(b=>b.onclick=()=>{
    toggleAdd(b.dataset.add, b.dataset.to); });
}

/* CSV */
const CSV_COLS=[['id','ID'],['dir','Направление'],['block','Блок'],['micro','Микроблок'],['ability','Способность'],
  ['status','Статус'],['text','Текст'],['source','Источник'],['needs_example','Требует примера'],
  ['example_hint','Подсказка примера'],['links_goal','Цели(ID)'],['links_meth','Приёмы(ID)'],
  ['links_rec','Рекомендации(ID)'],['tags','Теги'],['active','Активна']];
function csvCell(v){ if(v===true) return 'Да'; if(v===false) return 'Нет'; if(Array.isArray(v)) return '"'+v.join(';')+'"';
  v=String(v==null?'':v); return /[",;\n]/.test(v)? '"'+v.replace(/"/g,'""')+'"' : v; }
function toCsv(rows){ return CSV_COLS.map(c=>c[1]).join(';')+'\n'
  + rows.map(r=>CSV_COLS.map(c=>csvCell(r[c[0]])).join(';')).join('\n'); }
function parseCsv(text){
  text=text.replace(/^\ufeff/,''); const lines=text.split(/\r?\n/).filter(l=>l.trim());
  const head=splitCsvLine(lines[0]); const mapIdx={};
  CSV_COLS.forEach(([k,label])=>{ const i=head.indexOf(label); if(i>=0) mapIdx[k]=i;
    const j=head.indexOf(k); if(j>=0&&mapIdx[k]===undefined) mapIdx[k]=j; });
  const out=[];
  for(let i=1;i<lines.length;i++){
    const cells=splitCsvLine(lines[i]); const o={};
    Object.keys(mapIdx).forEach(k=>{ o[k]=cells[mapIdx[k]]||''; });
    ['links_goal','links_meth','links_rec'].forEach(k=>{ o[k]=String(o[k]||'').split(/[;,]/).map(s=>s.trim()).filter(Boolean); });
    o.needs_example = ['да','1','true','yes'].indexOf(String(o.needs_example).toLowerCase())>=0;
    o.active = !(['нет','0','false','no'].indexOf(String(o.active).toLowerCase())>=0);
    if(!o.id || !o.text) continue;
    o.status=o.status||''; o.dir=o.dir||'IV'; o.block=o.block||'AS'; o.micro=o.micro||'';
    o.ability=o.ability||''; o.source=o.source||''; o.example_hint=o.example_hint||''; o.tags=o.tags||'';
    out.push(o);
  }
  return out;
}
function splitCsvLine(line){
  const res=[]; let cur='',q=false;
  for(let i=0;i<line.length;i++){ const c=line[i];
    if(q){ if(c==='"'){ if(line[i+1]==='"'){cur+='"';i++;} else q=false; } else cur+=c; }
    else { if(c==='"') q=true; else if(c===';'||c===','){res.push(cur);cur='';} else cur+=c; } }
  res.push(cur); return res.map(s=>s.trim());
}

/* --------------------------------------------------------- СОХРАНЕНИЕ ПРОЕКТА */
function saveProject(){
  const payload={project:'iv-constructor',version:BANK.meta.version,saved:new Date().toISOString(),doc:S};
  downloadBlob(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}),
    'проект_'+(S.header.fio||'без_ФИО').replace(/\s+/g,'_')+'.json');
}
function loadProject(file){
  const r=new FileReader(); r.onload=()=>{ try{ const p=JSON.parse(r.result);
      if(p.doc){ S=p.doc; ensureMicro(); save(); render(); flash('Проект загружен'); }
      else alert('В файле нет данных документа'); }catch(e){ alert('Не удалось прочитать файл: '+e.message); } };
  r.readAsText(file,'utf-8');
}
function importBank(file){
  const r=new FileReader(); r.onload=()=>{
    const txt=r.result;
    try{
      if(/\.csv$/i.test(file.name)){ const rows=parseCsv(txt);
        if(!rows.length) throw new Error('в CSV не найдено строк');
        const idx={}; BANK.phrases.forEach(p=>idx[p.id]=p);
        rows.forEach(row=>{ if(idx[row.id]) Object.assign(idx[row.id],row); else BANK.phrases.push(row); });
        BANK=indexBank(BANK); persistBank(); render(); flash('Импортировано строк: '+rows.length);
      } else {
        const b=JSON.parse(txt);
        if(b.project && b.doc){ S=b.doc; ensureMicro(); save(); render(); flash('Проект загружен'); return; }
        if(!b.phrases) throw new Error('в JSON нет массива phrases');
        const data=Object.assign({}, BANK_DEFAULT, b);
        BANK=indexBank(data); persistBank(); render(); flash('Банк загружен: '+BANK.phrases.length+' фраз');
      }
    }catch(e){ alert('Импорт не удался: '+e.message); }
  };
  r.readAsText(file,'utf-8');
}

/* ---------------------------------------------------------------- СТАРТ */
$('#btnTheme').onclick=()=>{ UI.theme = UI.theme==='dark'?'light':'dark'; saveUI(); applyUI(); };
$('#btnFontMinus').onclick=()=>{ if(UI.fsIdx>0){ UI.fsIdx--; saveUI(); applyUI(); } };
$('#btnFontPlus').onclick=()=>{ if(UI.fsIdx<FS_STEPS.length-1){ UI.fsIdx++; saveUI(); applyUI(); } };
$('#btnMode').onclick=()=>{ UI.mode = isSimple()?'full':'simple'; saveUI(); applyUI(); render(); };
applyUI();
const _nj=$('#nojs'); if(_nj) _nj.remove();   // JavaScript работает — инструкция не нужна
$('#ver').textContent = V1VER+' · банк данных '+BANK.meta.version+' от '+BANK.meta.updated;
if(!LS.ok){ $('#saveinfo').textContent='⚠ автосохранение в браузере недоступно — сохраняйте проект кнопкой';
  $('#saveinfo').style.color='#ffd9a0'; }
$('#btnSaveProject').onclick=saveProject;
$('#btnLoadProject').onclick=()=>$('#fileProject').click();
$('#btnReset').onclick=()=>{ if(confirm('Создать новый документ? Текущий черновик будет удалён.')){ S=blankDoc(); ensureMicro(); save(); render(); } };
$('#fileProject').onchange=e=>{ if(e.target.files[0]) loadProject(e.target.files[0]); e.target.value=''; };
$('#fileBank').onchange=e=>{ if(e.target.files[0]) importBank(e.target.files[0]); e.target.value=''; };
window.addEventListener('beforeunload', save);
ensureMicro(); save(); render();
</script>
</body>
</html>
